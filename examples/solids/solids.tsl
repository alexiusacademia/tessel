// Shapes in three dimensions. Drag to look around; move the slider to
// come closer.

app Solids(width: 720, height: 520) {
    state yaw = 0.7
    state pitch = 0.45
    state distance = 9.0
    state wave = true

    VStack(spacing: 0) {
        Scene3D { s in
            s.orbit(distance: distance, yaw: yaw, pitch: pitch, y: 0.6)
            s.light(x: 3, y: 5, z: 2)
            s.light(x: -4, y: 2, z: -3, color: .rgb(120, 150, 255), strength: 0.4)

            s.plane(width: 8, depth: 8, color: .rgb(210, 214, 222))
            s.box(color: .red, x: -2, y: 0.5)
            s.sphere(radius: 0.7, color: .blue, y: 0.7, opacity: 0.6)
            s.cylinder(radius: 0.5, height: 1.4, color: .green, x: 2, y: 0.7)
            s.cone(radius: 0.6, height: 1.2, color: .orange, y: 0.6, z: -2)

            // A box turned on its corner: transforms apply to what follows.
            s.save()
            s.translate(-2, 1.9, 0)
            s.rotateY(0.6)
            s.rotateX(0.6)
            s.box(width: 0.6, height: 0.6, depth: 0.6, color: .purple)
            s.restore()

            if wave {
                var heights: [Float] = []
                for j in 0..30 {
                    for i in 0..30 {
                        let x = Float(i) / 29.0 * 6.0 - 3.0
                        let z = Float(j) / 29.0 * 6.0 - 3.0
                        heights.append(sin(sqrt(x * x + z * z) * 2.5) * 0.25)
                    }
                }
                s.save()
                s.translate(0, 0.3, 2.4)
                s.surface(heights: heights, columns: 30, width: 2.4, depth: 2.4, colors: [.blue, .green, .yellow, .red])
                s.restore()
            }

            // The axes.
            s.line(0, 0.01, 0, 4, 0.01, 0, color: .red)
            s.line(0, 0, 0, 0, 3, 0, color: .green)
            s.line(0, 0.01, 0, 0, 0.01, 4, color: .blue)
            s.label("x", x: 4.2, color: .red)
            s.label("y", y: 3.2, color: .green)
            s.label("z", z: 4.2, color: .blue)
        }
        .background(.rgb(246, 247, 250))
        .onDrag { dx, dy in
            yaw -= dx * 0.01
            pitch = (pitch + dy * 0.01).clamped(min: -1.5, max: 1.5)
        }

        HStack(spacing: 12) {
            Text("Distance")
            Slider(value: distance, from: 4, to: 20)
            Toggle("Wave", isOn: wave)
        }
        .padding(12)
    }
}
