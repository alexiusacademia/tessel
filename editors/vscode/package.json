{
  "name": "tessel",
  "displayName": "Tessel",
  "description": "Tessel language support: syntax highlighting, errors as you type, types on hover and code completion",
  "version": "0.2.0",
  "publisher": "alexiusacademia",
  "license": "MIT",
  "icon": "icon.png",
  "keywords": [
    "tessel",
    "tsl",
    "gui",
    "language",
    "lsp"
  ],
  "homepage": "https://tessel-lang.syncster.dev",
  "bugs": {
    "url": "https://github.com/alexiusacademia/tessel/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/alexiusacademia/tessel",
    "directory": "editors/vscode"
  },
  "galleryBanner": {
    "color": "#1E1E2E",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "tessel",
        "aliases": [
          "Tessel",
          "tessel"
        ],
        "extensions": [
          ".tsl"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "tessel",
        "scopeName": "source.tessel",
        "path": "./syntaxes/tessel.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "Tessel",
      "properties": {
        "tessel.path": {
          "type": "string",
          "default": "tessel",
          "description": "Path to the `tessel` command, used for errors, hover and completion."
        }
      }
    }
  },
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:tessel"
  ],
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "scripts": {
    "package": "npx --yes @vscode/vsce package",
    "publish": "npx --yes @vscode/vsce publish"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Highlighting works everywhere. Error checking runs the `tessel` command, and a folder's `tessel.path` setting is only used once the folder is trusted.",
      "restrictedConfigurations": [
        "tessel.path"
      ]
    }
  }
}
