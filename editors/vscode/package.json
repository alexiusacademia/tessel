{
  "name": "tessel",
  "displayName": "Tessel",
  "description": "Tessel language support: highlighting, errors as you type, types on hover, completion, commands to run and build, and tessel.toml checking",
  "version": "0.3.0",
  "publisher": "alexiusacademia",
  "license": "MIT",
  "icon": "icon.png",
  "keywords": [
    "tessel",
    "tsl",
    "gui",
    "language",
    "lsp"
  ],
  "homepage": "https://tessel-lang.syncster.dev",
  "bugs": {
    "url": "https://github.com/alexiusacademia/tessel/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/alexiusacademia/tessel",
    "directory": "editors/vscode"
  },
  "galleryBanner": {
    "color": "#1E1E2E",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "tessel",
        "aliases": [
          "Tessel",
          "tessel"
        ],
        "extensions": [
          ".tsl"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "tessel",
        "scopeName": "source.tessel",
        "path": "./syntaxes/tessel.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "Tessel",
      "properties": {
        "tessel.path": {
          "type": "string",
          "default": "tessel",
          "description": "Path to the `tessel` command, used for errors, hover and completion."
        }
      }
    },
    "commands": [
      {
        "command": "tessel.run",
        "title": "Run Program",
        "category": "Tessel",
        "icon": "$(play)"
      },
      {
        "command": "tessel.runHot",
        "title": "Run with Hot Reload",
        "category": "Tessel",
        "icon": "$(flame)"
      },
      {
        "command": "tessel.check",
        "title": "Check Program",
        "category": "Tessel"
      },
      {
        "command": "tessel.build",
        "title": "Build App",
        "category": "Tessel"
      },
      {
        "command": "tessel.pin",
        "title": "Pin Tessel Version",
        "category": "Tessel"
      },
      {
        "command": "tessel.restart",
        "title": "Restart Language Server",
        "category": "Tessel"
      }
    ],
    "menus": {
      "editor/title/run": [
        {
          "command": "tessel.run",
          "when": "resourceLangId == tessel",
          "group": "navigation@1"
        },
        {
          "command": "tessel.runHot",
          "when": "resourceLangId == tessel",
          "group": "navigation@2"
        }
      ],
      "commandPalette": [
        {
          "command": "tessel.run",
          "when": "editorLangId == tessel"
        },
        {
          "command": "tessel.runHot",
          "when": "editorLangId == tessel"
        },
        {
          "command": "tessel.check",
          "when": "editorLangId == tessel"
        },
        {
          "command": "tessel.build",
          "when": "editorLangId == tessel"
        }
      ]
    },
    "tomlValidation": [
      {
        "fileMatch": "tessel.toml",
        "url": "./schemas/tessel.toml.json"
      }
    ]
  },
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:tessel"
  ],
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "scripts": {
    "package": "npx --yes @vscode/vsce package",
    "publish": "npx --yes @vscode/vsce publish"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Highlighting works everywhere. Error checking runs the `tessel` command, and a folder's `tessel.path` setting is only used once the folder is trusted.",
      "restrictedConfigurations": [
        "tessel.path"
      ]
    }
  }
}
