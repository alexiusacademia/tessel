// The outline of text, its glyphs as they're placed, and its font's
// metrics. What's printed holds on every system, whatever its fonts.

fn contours(_ path: [Float]) -> Int {
    var count = 0
    var i = 0
    while i < path.count {
        let c = Int(path[i])
        if c == 0 {
            count += 1
            i += 3
        } else if c == 1 {
            i += 3
        } else if c == 2 {
            i += 7
        } else {
            i += 1
        }
    }
    count
}

fn main() {
    // An outline: parts that start with a move and are closed.
    let o = textOutline("o", size: 40)
    print("o: {contours(o)} contours, starts with a move: {o[0] == 0}, closed: {o[o.count - 1] == 3}")
    print("nothing: {textOutline("", size: 40).count}")
    let bold = textOutline("I", size: 40, weight: .bold)
    let thin = textOutline("I", size: 40, weight: .light)
    print("two weights differ: {bold != thin}")

    // Glyphs: one for each letter here, each line lower than the one before.
    let g = textGlyphs("ab\ncd", size: 20)
    print(g.map { x in "{x.start}-{x.end}" }.joined(" "))
    print("second line lower: {g[2].y > g[0].y}, starts again at the left: {g[2].x < g[1].x}")
    print("in order: {g[1].x > g[0].x && g[1].x >= g[0].x + g[0].advance - 0.01}")
    // Tracking adds its room after each glyph.
    let plain = textGlyphs("AB", size: 50)
    let spaced = textGlyphs("AB", size: 50, tracking: 10)
    print("tracking adds 10: {(spaced[1].x - plain[1].x - 10).clamped(min: -0.01, max: 0.01) == spaced[1].x - plain[1].x - 10}")
    // Kerning pulls A and V together; without it they're further apart.
    let kerned = textGlyphs("AV", size: 100)
    let apart = textGlyphs("AV", size: 100, kerning: false)
    print("kerning: {kerned[1].x <= apart[1].x}")

    let m = fontMetrics(size: 100)
    print("metrics: {m.ascent > m.capHeight && m.capHeight > m.xHeight && m.xHeight > 0 && m.descent > 0}")
    print("line: {m.lineHeight == m.ascent + m.descent + m.lineGap}")
    print("no such family: {fontStyles("No Such Font Family").count}")
}
