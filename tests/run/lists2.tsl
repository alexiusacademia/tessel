// The standard library's list methods.

struct Item {
    name: String
    price: Float
}

fn main() {
    let nums = [4, 8, 15, 16, 23, 42, 8]
    print("{nums.index(of: 8) ?? -1} {nums.lastIndex(of: 8) ?? -1} {nums.index(of: 99) ?? -1}")
    print("{nums.firstIndex(where: { n in n > 10 }) ?? -1} {nums.count(where: { n in n % 2 == 0 })}")
    print("{nums.any(where: { n in n > 40 })} {nums.all(where: { n in n > 0 })} {nums.all(where: { n in n > 5 })}")
    print("{nums.sum()} {nums.min() ?? -1} {nums.max() ?? -1}")
    let noFloats: [Float] = []
    print("{[1.5, 2.25].sum()} {noFloats.max() ?? -1.0}")
    let words = ["pear", "apple", "fig", "apple"]
    print("{words.min() ?? "?"} {words.max() ?? "?"} {words.unique().joined(separator: ",")}")
    print("{nums.prefix(2).count} {nums.suffix(3).sum()} {nums.dropFirst().count} {nums.dropLast(2).count}")
    print("{nums.slice(from: 1, to: 3).sum()} {nums.slice(from: 5, to: 100).count} {nums.prefix(100).count}")
    print("{nums.indices} {nums.shuffled().count} {nums.shuffled().sum() == nums.sum()}")
    print(nums.randomElement() != nil)
    let noInts: [Int] = []
    print(noInts.randomElement() == nil)

    var items = [Item(name: "a", price: 1.0), Item(name: "b", price: 2.5)]
    items.appendAll([Item(name: "c", price: 4.0)])
    let first = items.removeFirst()
    let last = items.removeLast()
    print("{first.name} {last.name} {items.count} {items[0].name}")
    print(items.index(of: Item(name: "b", price: 2.5)) ?? -1)
    for i in words.indices {
        print("{i}: {words[i]}")
    }
}
