// Where the device is, its satellites and its compass, made up
// (`sensors.env`): permissions are granted when asked.

fn show() {
    print(location() == nil)
    print(satellites().count)
    print(heading() == nil)
}

async fn main() {
    print(hasPermission(.location))
    print(startLocation())
    show()
    let ok = await requestPermission(.location)
    print("allowed: {ok}")
    print(startLocation(precise: true, interval: 2))
    print(startCompass())
    show()
    if let l = location() {
        print("{l.latitude} {l.longitude} {l.altitude ?? -1} ±{l.accuracy ?? -1} {l.source} {l.course == nil}")
    }
    for s in satellites() {
        if s.system == "GLONASS" {
            print("{s.system} {s.number} az {s.azimuth} el {s.elevation} {s.signal} used {s.used} {s.frequency ?? 0}")
        }
    }
    print(satellites().filter { s in s.used }.count)
    if let h = heading() {
        print("{h.magnetic} {(h.geographic ?? -1).formatted(1)} {h.accuracy}")
    }
    stopLocation()
    stopCompass()
    show()
}
