// writePDF: pages drawn with Graphics, a new one with g.newPage().

fn main() {
    let path = joinPath(tempFolder(), "tessel-pdf-test.pdf")
    var sizes: [String] = []
    let ok = writePDF(path: path, title: "Test", width: 300, height: 200) { g in
        sizes.append("{Int(g.width)}x{Int(g.height)}")
        g.text("Page 1", x: 20, y: 20, size: 18, weight: .bold)
        g.translate(10, 10)
        g.fillRect(x: 20, y: 60, width: 100, height: 40, color: .blue)
        g.newPage()
        // A new page starts with nothing transformed.
        g.text("Page 2", x: 20, y: 20)
        g.newPage()
        g.circle(x: 150, y: 100, radius: 50)
        g.fill(.red)
    }
    print(ok)
    print(sizes)
    let data = readData(path) ?? Data()
    print(data.slice(from: 0, to: 5).text ?? "")
    // The page tree says how many pages there are. (Without zero bytes,
    // which end Latin-1 text.)
    let text = Data(bytes: data.bytes.filter { b in b != 0 }).latin1
    print(text.contains("/Count 3"))

    // Outside writePDF, newPage does nothing.
    let png = joinPath(tempFolder(), "tessel-pdf-test.png")
    print(renderImage(path: png, width: 10, height: 10) { g in
        g.newPage()
        g.fillRect(x: 0, y: 0, width: 10, height: 10, color: .green)
    })
    deleteFile(path)
    deleteFile(png)
}
