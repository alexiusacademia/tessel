// Font families and italic: `.font(italic:family:)`, `g.text(italic:family:)`,
// `g.textWidth(italic:family:)` and `fontFamilies()`. (Linux has none of
// the fonts macOS and Windows have; its tests have DejaVu and Liberation.)

let mono = if platform() == "linux" { "Liberation Mono" } else { "Courier New" }
let serif = if platform() == "linux" { "DejaVu Serif" } else { "Georgia" }

app Fonts(width: 360, height: 240) {
    VStack(spacing: 6, alignment: .leading) {
        Text("System, italic").font(italic: true)
        Text(mono).font(family: mono)
        Text("Monospaced").font(family: "monospaced")
        VStack(alignment: .leading) {
            Text("Inherited")
            Text("Upright again").font(italic: false)
        }.font(size: 16, italic: true, family: serif)
        Canvas { g in
            g.text("Drawn", x: 0, y: 0, size: 16, italic: true, family: serif)
            // In a monospaced family, every letter is as wide.
            let monospaced = g.textWidth("iiii", family: "monospaced") == g.textWidth("MMMM", family: "monospaced")
            let courier = g.textWidth("iiii", family: mono) == g.textWidth("MMMM", family: mono)
            let system = g.textWidth("iiii") == g.textWidth("MMMM")
            // A family that isn't installed is drawn in the system's.
            let missing = g.textWidth("Hello", family: "No Such Font") == g.textWidth("Hello")
            let named = g.textWidth("Hello", family: serif) != g.textWidth("Hello")
            print("monospaced {monospaced}, {mono} {courier}, system {system}, missing {missing}, named {named}")
            let families = fontFamilies()
            let sorted = families.sorted(by: { a, b in a.lowercase() < b.lowercase() })
            print("families: {families.count > 5}, sorted: {families == sorted}")
            print("{serif}: {families.contains(serif)}, hidden: {families.any(where: { f in f.hasPrefix(".") })}")
        }.frame(height: 30)
    }
}
