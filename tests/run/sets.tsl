enum Hue { red, green, blue }

fn main() {
    var seen: Set<Int> = [3, 1, 4, 1, 5, 9, 2, 6, 5, 3, 5]
    print(seen.count)
    print(seen.contains(4))
    print(seen.contains(7))
    seen.insert(7)
    seen.insert(7)
    seen.remove(1)
    print(toJson(seen.sorted()))
    let words = Set(["apple", "pear", "apple"])
    print(words.count)
    var empty = Set<String>()
    print(empty.isEmpty)
    empty.insert("x")
    print(toJson(empty.values))
    let a: Set<Int> = [1, 2, 3]
    let b: Set<Int> = [2, 3, 4]
    print(toJson(a.union(b).sorted()))
    print(toJson(a.intersection(b).sorted()))
    print(toJson(a.subtracting(b).sorted()))
    print(a.isSubset(of: a.union(b)))
    print(a.isSuperset(of: [1, 2]))
    print(a.isDisjoint(with: [7, 8]))
    print(a == [3, 2, 1])
    print(a != b)
    var total = 0
    for x in a {
        total += x
    }
    print(total)
    print(toJson(a.filter { x in x > 1 }.sorted()))
    let visited: Set<(Int, Int)> = [(0, 0), (0, 1), (0, 0)]
    print(visited.count)
    print(visited.contains((0, 1)))
    let colors: Set<Hue> = [.red, .blue]
    print(colors.contains(.green))
    let json = toJson(a)
    print(json)
    let back: Set<Int>? = fromJson("[5, 5, 6]")
    print(back?.count ?? 0)
    let copy = a
    var b2 = a
    b2.insert(100)
    print(copy.count)
    print(b2.count)
    let s: [Set<String>] = [["a"], ["b", "c"]]
    print(s[1].count)
}
