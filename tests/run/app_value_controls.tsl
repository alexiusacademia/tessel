// Slider, Stepper and ColorPicker, with the mouse and the keyboard.

app Style(width: 360, height: 300) {
    state opacity = 0.5
    state width = 1.0
    state classes = 5
    state fill: Color = .blue
    state changes = 0

    VStack(spacing: 10, alignment: .leading) {
        HStack {
            Text("Opacity")
            Slider(value: opacity, from: 0, to: 1, step: 0.1) { changes += 1 }
        }
        HStack {
            Text("Width")
            Stepper(value: width, step: 0.5, from: 0, to: 3, onChange: { changes += 1 })
            Text("Classes")
            Stepper(value: classes, from: 2, to: 6)
        }
        HStack {
            Text("Fill")
            ColorPicker(color: fill) { changes += 1 }
        }
        Text("{opacity.formatted(decimals: 2)} {width} {classes} changes {changes}")
    }
    .padding(16)
}
