// Asking an interface value which type it holds: is and as?.

interface Shape {
    fn area() -> Float
}

struct Circle: Shape {
    radius: Float
    fn area() -> Float { pi * radius * radius }
}

enum Tri: Shape {
    right(a: Float, b: Float)
    fn area() -> Float {
        match self {
            .right(a, b) -> a * b / 2.0
        }
    }
}

fn main() {
    let shapes: [Shape] = [Circle(radius: 1.0), Tri.right(a: 3.0, b: 4.0), Circle(radius: 2.0)]
    var circles = 0
    for s in shapes {
        if s is Circle {
            circles += 1
        }
        if let c = s as? Circle {
            print("circle with radius {c.radius}")
        } else if let t = s as? Tri {
            print("triangle, area {t.area()}")
        }
    }
    print("{circles} circles, first is a Tri: {shapes[0] is Tri}")
    let radii = shapes.filter { s in s is Circle }.map { s in (s as? Circle)?.radius ?? 0.0 }
    print(radii.count)
}
