// A scene in three dimensions: what its block puts in it, kept with
// `redraw:`, and the mouse over it.

app Solids(width: 400, height: 300) {
    state shapes = 1
    state version = 0
    state yaw = 0.5

    VStack {
        Scene3D { s in
            s.orbit(distance: 6, yaw: yaw)
            s.light(x: 1, y: 2, z: 3)
            s.ambient(0.2)
            s.background(.black)
            for i in 0..shapes {
                s.box(color: .red, x: Float(i))
            }
            s.save()
            s.translate(0, 2, 0)
            s.rotateY(0.5)
            s.scale(2, 1, 1)
            s.line(0, 0, 0, 1, 0, 0)
            s.restore()
            s.label("top", y: 1)
            // (Nothing to show: no text, points that aren't there.)
            s.label("")
            s.mesh(vertices: [0, 0, 0, 1, 0, 0, 0, 1, 0], triangles: [0, 1, 7])
            s.surface(heights: [1.0], columns: 1)
        }
        .onDrag { dx, dy in yaw += dx / 100 }

        // Kept until `version` changes.
        Scene3D(redraw: version) { s in
            print("the second scene, with {shapes}")
            s.sphere(opacity: 0.5)
            s.cylinder(x: 2)
            s.cone(x: -2)
            s.plane(width: 6, depth: 6, color: .rgba(0, 0, 255, 0.3), y: -0.5)
            s.mesh(vertices: [0, 0, 0, 1, 0, 0, 0, 1, 0, 1, 1, 0], triangles: [0, 1, 2, 2, 1, 3], colors: [.red, .green, .blue], smooth: true, opacity: 0.8)
            s.surface(heights: [0, 1, 0, 1, 0, 1, 0, 1, 0], columns: 3, colors: [.blue, .red])
            s.lines([0, 0, 0, 1, 0, 0, 1, 1, 0], closed: true)
            print("{s.width > 0 && s.height > 0}")
        }
        .frame(height: 100)

        HStack {
            Button("More") { shapes += 1 }
            Button("Again") { version += 1 }
            Text("yaw {yaw.formatted(2)}")
        }
    }
}
