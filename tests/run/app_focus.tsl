// Tab and Shift+Tab move between text fields (skipping hidden and disabled
// ones) and the controls among them (the button, which takes no typing),
// and text composed with an input method.

app Focus(width: 360, height: 300) {
    state first = "Ada"
    state last = ""
    state secret = "hidden"
    state locked = "locked"
    state city = ""

    VStack(spacing: 8) {
        TextField("First name", text: first)
        TextField("Last name", text: last)
        TextField("Secret", text: secret).hidden()
        TextField("Locked", text: locked).disabled()
        Button("Save") {}
        TextField("City", text: city)
        Text("{first} {last}, {city}")
    }
    .padding(16)
}
