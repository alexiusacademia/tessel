enum Size { small, medium, large }

app Keys(width: 360, height: 300) {
    state name = ""
    state count = 0
    state on = false
    state size = Size.small
    state tab = "one"

    VStack(spacing: 10) {
        TextField("Name", text: name)
        Button("Add") { count += 1 }
        Toggle("Loud", isOn: on)
        Picker(selection: size) {
            Text("S").tag(Size.small)
            Text("M").tag(Size.medium)
            Text("L").tag(Size.large)
        }
        Text("count {count}, on {on}, size {size}, tab {tab}")
        TabView(selection: tab) {
            Text("first page").tabItem("One").tag("one")
            Button("In two") { count += 10 }.tabItem("Two").tag("two")
        }
    }
    .padding(12)
}
