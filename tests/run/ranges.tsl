// Ranges as values: stored, passed, returned, in structs and lists, compared, shown.
struct Span {
    rows: Range
    name: String = "s"
}

fn firstN(n: Int) -> Range {
    0..n
}

fn total(r: Range) -> Int {
    var sum = 0
    for i in r {
        sum += i
    }
    sum
}

fn main() {
    let r = 0..3
    for i in r {
        print(i)
    }
    print("{r} and {1..2}")
    print((0..3) == (0..3))
    print((0..3) == (1..3))
    print(total(firstN(4)))
    let s = Span(rows: 2..5)
    print(total(s.rows))
    let ranges = [0..2, 5..7]
    for r in ranges {
        print(total(r))
    }
    let pick: fn(Int) -> Int = { k in total(0..k) }
    print(pick(5))
    print(s.rows == 2..5)
    print(s == Span(rows: 2..5))
}
