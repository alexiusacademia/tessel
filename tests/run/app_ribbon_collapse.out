Root
  View
    VStack
      Ribbon ["Home", "Insert"] selected "Home"
        RibbonTab "Home"
          RibbonGroup "Clipboard" small
            RibbonButton "Paste"
            RibbonButton "Cut"
            RibbonButton "Copy"
          RibbonGroup "Font" collapsed
            RibbonToggle "Bold" = false
            RibbonMenu "Borders" [MenuItem "All borders", MenuItem "No border"]
            TextField "Cell" = "A1"
          RibbonGroup "Editing" collapsed
            RibbonButton "Sum" large
            RibbonButton "Find" large
            RibbonButton "Sort"
            RibbonButton "Filter"
            RibbonButton "Clear"
      Text "bold false | A1 | "
      Spacer
