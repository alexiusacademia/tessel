// A function with `bind` parameters takes the caller's storage directly
// when every argument stays put (a variable or its fields, or an item of a
// list for a function with one `bind`): as fast as a method. Otherwise, or
// for a `bind` a closure keeps, it goes through a locator. Both must change
// the same things.

struct P {
    x: Int = 0
    items: [Int] = []
    inner: Q = Q()
}
struct Q {
    name: String = ""
}
fn grow(_ p: bind P, _ n: Int) {
    p.x += n
    p.items.append(n)
    p.inner.name = p.inner.name + "{n}"
}
fn both(_ a: bind P, _ b: bind P) {
    a.x += 1
    b.x += 10
}
fn rename(_ q: bind Q, _ to: String) { q.name = to }
fn keeps(_ p: bind P) -> fn() -> Int {
    // Captured: the slow version only.
    let read = { p.x }
    read
}
fn nested(_ p: bind P) {
    grow(p, 100)
    rename(p.inner, "nested")
}
fn main() {
    var p = P()
    grow(p, 1)
    grow(p, 2)
    rename(p.inner, "named")
    both(p, p)
    var list = [P(), P()]
    grow(list[1], 5)
    rename(list[0].inner, "first")
    nested(p)
    let read = keeps(p)
    p.x += 1
    print("kept {read()}")
    print("{p.x} {p.items} {p.inner.name} | {list[1].x} {list[1].items} {list[0].inner.name}")
    // An item of a list that another variable shares: only this one changes.
    var layers = [P(), P()]
    let before = layers
    grow(layers[1], 7)
    rename(layers[0].inner, "top")
    print("{layers[1].x} {layers[0].inner.name} | {before[1].x} '{before[0].inner.name}'")
    // A list of lists: the inner one moves when the outer grows (a locator).
    var grid = [[P()], [P()]]
    grow(grid[1][0], 3)
    // Two `bind`s, one an item: through locators.
    both(layers[0], layers[1])
    print("{grid[1][0].x} {layers[0].x} {layers[1].x}")
}
