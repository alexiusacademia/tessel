        x + "90", x + "91", x + "92", x + "93", x + "94", x + "95", x + "96", x + "97", x + "98", x + "99",
        try number(text: bad), x + "100", x + "101", x + "102", x + "103", x + "104", x + "105", x + "106", x + "107", x + "108",
        x + "109", x + "110", x + "111", x + "112", x + "113", x + "114", x + "115", x + "116", x + "117", x + "118",
