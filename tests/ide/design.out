              CodeEditor errors [] = "app Hello(width: 400, height: 300) {\n    state count = 0\n\n    VStack(spacing: 12) {\n        Text(\"Count: {count}\").font(size: 24, weight: .bold)\n        HStack {\n            Button(\"Add one\") { count += 1 }\n            Button(\"Reset\") { count = 0 }.padding(4)\n        }\n        Card(title: \"é card\") {\n            Text(\"inside\")\n        }\n        for i in 0..2 {\n            Text(\"row {i}\")\n                .color(.secondary)\n        }\n    }\n    .padding(16)\n}\n\nview Card(title: String, content: View) {\n    VStack(alignment: .leading) {\n        Text(title).font(weight: .bold)\n        content\n    }\n    .padding(8)\n    .background(.lightGray, radius: 6)\n}\n"
