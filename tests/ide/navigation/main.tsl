// Counts the words in a few lines.

fn main() {
    let lines = [
        "the quick brown fox",
        "jumps over",
        "the lazy dog",
    ]
    var count = 0
    for line in lines {
        count += wordCount(line)
    }
    print("{count} words")
    print(twice(count))
}

