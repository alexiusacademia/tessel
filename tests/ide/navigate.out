--- files: .cache, build, docs, helpers.tsl, main.tsl
--- helpers.tsl
// How many words a line has: the count of its pieces between spaces.
fn countWords(line: String) -> Int {
    line.split(" ").filter { w in w != "" }.count
}

fn twice(n: Int) -> Int {
    n * 2
}
