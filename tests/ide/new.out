              CodeEditor errors [] = "// The app: its window, its menus, and what the buttons do.\n// Run it with `tessel run .` (or Run in the IDE).\n\napp Project(width: 420, height: 520) {\n    state tasks: [Task] = loadTasks()\n    state draft = \"\"\n    state filter = Filter.all\n\n    VStack(spacing: 12, alignment: .leading) {\n        Text(\"Project\").font(size: 22, weight: .bold)\n\n        HStack(spacing: 8) {\n            TextField(\"What needs doing?\", text: draft)\n                .onSubmit { add() }\n                .autofocus()\n            Button(\"Add\") { add() }\n                .disabled(draft.trim() == \"\")\n        }\n\n        Picker(selection: filter) {\n            Text(\"All\").tag(Filter.all)\n            Text(\"To do\").tag(Filter.open)\n            Text(\"Done\").tag(Filter.done)\n        }\n\n        Scroll {\n            VStack(spacing: 2, alignment: .leading) {\n                for i in tasks.indices {\n                    if filter.shows(tasks[i]) {\n                        TaskRow(task: tasks[i], onToggle: { toggle(i) }, onDelete: { remove(i) })\n                    }\n                }\n            }\n        }\n        .frame(maxHeight: .infinity)\n\n        Text(summary()).color(.secondary)\n    }\n    .padding(16)\n    .menuBar {\n        Menu(\"List\") {\n            MenuItem(\"Clear Done\", shortcut: \"cmd+shift+k\") { clearDone() }\n                .disabled(!tasks.any(where: { t in t.done }))\n        }\n    }\n\n    fn add() {\n        let title = draft.trim()\n        if title != \"\" {\n            tasks.append(Task(title: title))\n            draft = \"\"\n            save()\n        }\n    }\n\n    fn toggle(_ i: Int) {\n        tasks[i].done = !tasks[i].done\n        save()\n    }\n\n    fn remove(_ i: Int) {\n        tasks.remove(at: i)\n        save()\n    }\n\n    fn clearDone() {\n        tasks = tasks.filter { t in !t.done }\n        save()\n    }\n\n    fn save() {\n        saveTasks(tasks)\n    }\n\n    fn summary() -> String {\n        let left = tasks.count(where: { t in !t.done })\n        if tasks.isEmpty { \"Nothing yet: add a task above.\" }\n        else if left == 0 { \"All done!\" }\n        else if left == 1 { \"1 task to do\" }\n        else { \"{left} tasks to do\" }\n    }\n}\n"
          Spacer
