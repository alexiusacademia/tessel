// The Tessel IDE, written in Tessel.

app Tessel(title: "Tessel", width: 1200, height: 780) {
    state project = normalize(path: environment("TESSEL_PROJECT") ?? currentFolder())
    state tree: [Entry] = []
    state expanded: [String] = []
    state selected = ""
    state docs: [Doc] = []
    state current = ""
    state problems: [Problem] = []
    state console: [String] = []
    state panel = Panel.problems
    state running: Int? = nil
    state reloadOnSave = true
    // The debugger: `tessel debug --lines` while a program is debugged
    // (`debugging`), where it's stopped (`calls`, innermost first, and the
    // one looked at), and its variables there. What's read from the
    // debugger a line at a time collects in the `…Coming` lists; `asked`
    // says what each list of variables on its way is for (the row whose
    // parts they are, or -1 for a call's variables).
    state breakpoints: [Breakpoint] = []
    state debugging: Int? = nil
    state debugStopped = false
    state debugNote = ""
    state calls: [DebugCall] = []
    state callShown = 0
    state vars: [DebugVar] = []
    state callsComing: [DebugCall] = []
    state varsComing: [DebugVar] = []
    state asked: [Int] = []
    // The Docs panel, next to the editor.
    state helpOpen = false
    state helpWidth = 440.0
    // The sizes of the explorer and of the bottom panel: their edges can
    // be dragged, like the Docs panel's.
    state explorerWidth = 250.0
    state panelHeight = 220.0
    // The Design panel, next to the editor: a picture of the app, as
    // `tessel preview` last made it (`design`), and the view selected in it.
    state designOpen = false
    state designWidth = 460.0
    state design = Design()
    state designSelected = -1
    // Where the selected view is written, to find it again in a new picture.
    state designPath = ""
    state designLo = -1
    // The texts the picture was made from; a preview is `designRunning`
    // until it's done, and `designFailed` if the code had errors.
    state designSeen: [DesignText] = []
    state designRunning = false
    state designFailed = false
    state designStatus = ""
    state designRequest = 0
    state designSession = random(0..1000000)
    // The timer that keeps the picture up to date, and what it last saw:
    // the texts, and the line the cursor was on.
    state designTimer = -1
    state designLast: [DesignText] = []
    state designCaret = ""
    // The Preview panel, next to the editor, for Markdown files.
    state previewOpen = false
    state previewWidth = 440.0
    state status = "Ready"
    state prompt = Prompt.none
    state promptText = ""
    // Code completion: the suggestions for the word starting at byte
    // `suggestStart` of `suggestPath`, from the latest request.
    state suggestions: [Completion] = []
    state suggestStart = -1
    state suggestPath = ""
    state suggestRequest = 0
    // A newer Tessel, like "v0.1.3", once the startup check finds one.
    state newVersion = ""
    state updating = false

    VStack(spacing: 0) {
        // Toolbar
        HStack(spacing: 8) {
            Text("Tessel").font(size: 15, weight: .bold)
            Text(fileName(project)).color(.secondary)
            Spacer()
            Text(status).color(.secondary)
            if newVersion != "" {
                ToolButton(icon: .download, label: "Update to {newVersion}", tint: .blue) { updateTessel() }.disabled(updating)
            }
            Toggle("Reload on save", isOn: reloadOnSave)
            ToolButton(icon: .save, label: "Save") { save() }.shortcut("s") { save() }
            ToolButton(icon: .circleCheck, label: "Check") { check() }.shortcut("k") { check() }
            if debugging != nil {
                // (While a program is debugged, the debugger's controls.)
                if debugStopped {
                    ToolButton(icon: .play, label: "Continue", tint: .green) { debugSend("continue") }
                } else {
                    // (It stops at the next line it runs: an app that's
                    // waiting for a click, when it gets one.)
                    ToolButton(icon: .clock, label: "Pause") { debugSend("pause") }
                }
                ToolButton(icon: .arrowRight, label: "Step over") { debugSend("next") }.disabled(!debugStopped).shortcut("'") { debugSend("next") }
                ToolButton(icon: .arrowDown, label: "Step in") { debugSend("step") }.disabled(!debugStopped).shortcut(";") { debugSend("step") }
                ToolButton(icon: .arrowUp, label: "Step out") { debugSend("out") }.disabled(!debugStopped).shortcut("shift+;") { debugSend("out") }
                ToolButton(icon: .stop, label: "Stop", tint: .red) { debugOrStop() }.shortcut("shift+r") { debugOrStop() }
            } else if running == nil {
                ToolButton(icon: .play, label: "Run", tint: .green) { runOrStop() }.shortcut("r") { runOrStop() }
                ToolButton(icon: .bug, label: "Debug") { debugOrStop() }.shortcut("shift+r") { debugOrStop() }
            } else {
                ToolButton(icon: .stop, label: "Stop", tint: .red) { runOrStop() }.shortcut("r") { runOrStop() }
            }
            // (The debugger's buttons take their room while it's used.)
            if debugging == nil {
                ToolButton(icon: .hammer, label: "Build") { build(bundle: false) }.shortcut("b") { build(bundle: false) }
                ToolButton(icon: .package, label: "Package") { build(bundle: true) }
            }
            if isMarkdown(path: current) {
                ToolButton(icon: .eye, label: "Preview", tint: if previewOpen { .blue } else { .primary }) { togglePreview() }
            }
            ToolButton(icon: .image, label: "Design", tint: if designOpen { .blue } else { .primary }) { toggleDesign() }
            ToolButton(icon: .info, label: "Docs", tint: if helpOpen { .blue } else { .primary }) { toggleHelp() }
        }
        .padding(8)
        Divider()

        // The explorer, the editor and the bottom panel; then, beside them
        // all, the Preview, Design or Docs panel.
        HStack(spacing: 0, alignment: .top) {
            VStack(spacing: 0) {
                HStack(spacing: 0, alignment: .top) {
                    // Explorer
                    VStack(spacing: 0, alignment: .leading) {
                        HStack(spacing: 2) {
                            Text("EXPLORER").font(size: 11, weight: .semibold).color(.secondary)
                            Spacer()
                            IconButton(icon: .filePlus) { ask(Prompt.newFile) }.tooltip("New file")
                            IconButton(icon: .folderPlus) { ask(Prompt.newFolder) }.tooltip("New folder")
                            IconButton(icon: .pencil) { ask(Prompt.rename) }.tooltip("Rename")
                            IconButton(icon: .trash) { ask(Prompt.delete) }.tooltip("Delete")
                        }
                        .padding(8)
                        Text(fileName(project).uppercase()).font(size: 11, weight: .bold).padding(8)

                        match prompt {
                            .none -> Spacer().frame(height: 0)
                            .delete -> HStack(spacing: 6) {
                                Text("Delete {fileName(selected)}?").font(size: 12)
                                Spacer()
                                Button("Delete") { confirm() }
                                Button("Cancel") { prompt = Prompt.none }
                            }
                            .padding(6)
                            _ -> TextField(promptLabel(), text: promptText).autofocus().onSubmit { confirm() }.padding(6)
                        }

                        Scroll {
                            VStack(spacing: 0, alignment: .leading) {
                                for e in tree {
                                    HStack(spacing: 5) {
                                        Spacer().frame(width: Float(e.depth) * 14)
                                        if e.folder && expanded.contains(e.path) {
                                            Icon(.chevronDown).font(size: 11).color(.secondary)
                                            Icon(.folderOpen).font(size: 13).color(.blue)
                                            Text(e.name).font(size: 13)
                                        } else if e.folder {
                                            Icon(.chevronRight).font(size: 11).color(.secondary)
                                            Icon(.folder).font(size: 13).color(.blue)
                                            Text(e.name).font(size: 13)
                                        } else if e.name.hasSuffix(".tsl") {
                                            Spacer().frame(width: 13)
                                            Icon(.fileCode).font(size: 13).color(.blue)
                                            Text(e.name).font(size: 13)
                                        } else {
                                            Spacer().frame(width: 13)
                                            Icon(.file).font(size: 13).color(.gray)
                                            Text(e.name).font(size: 13).color(.secondary)
                                        }
                                        Spacer()
                                    }
                                    .padding(4)
                                    .background(if e.path == selected { .highlight } else { .clear })
                                    .hoverBackground(.lightGray)
                                    .onTap { choose(e) }
                                }
                            }
                        }
                    }
                    .frame(width: explorerWidth)
                    .background(.sidebar)
                    Spacer()
                        .frame(width: 5, maxHeight: .infinity)
                        .background(.separator)
                        .hoverBackground(.blue)
                        .onDrag { dx, dy in explorerWidth = (explorerWidth + dx).clamped(min: 160, max: 500) }

                    // Editor tabs
                    if docs.isEmpty {
                        // Fills the space next to the explorer, with its content in the middle.
                        VStack(spacing: 10) {
                            Icon(.fileCode).font(size: 40).color(.lightGray)
                            if hasTesselFiles() {
                                Text("Open a file from the explorer").color(.secondary)
                            } else {
                                Text("This folder has no Tessel files yet. Start a project:").color(.secondary)
                                HStack(spacing: 8) {
                                    Button("To-do app") { createProject(template: "app") }
                                        .tooltip("A small app in a few files: a window, a menu, a view of its own, and saving")
                                    Button("Blank app") { createProject(template: "blank") }
                                        .tooltip("An app with one window and a button")
                                    Button("Command line") { createProject(template: "cli") }
                                        .tooltip("A program that runs in a terminal")
                                }
                            }
                        }
                        .frame(maxWidth: .infinity, maxHeight: .infinity)
                    } else {
                        TabView(selection: current, onClose: { path in closeDoc(path: path) }) {
                            for doc in docs {
                                CodeEditor(
                                    text: doc.text,
                                    errorLines: errorLines(path: doc.path),
                                    line: doc.line,
                                    completions: if doc.path == suggestPath { suggestions } else { [] },
                                    completionStart: if doc.path == suggestPath { suggestStart } else { -1 },
                                    onComplete: { offset in complete(path: doc.path, offset: offset) },
                                    breakpoints: breakpointLines(path: doc.path),
                                    stoppedLine: stoppedLine(path: doc.path),
                                    onBreakpoint: { line in toggleBreakpoint(path: doc.path, line: line) }
                                )
                                    .padding(8)
                                    .id(doc.path)
                                    .tabItem(if doc.text != doc.saved { "• {fileName(doc.path)}" } else { fileName(doc.path) })
                                    .tag(doc.path)
                            }
                        }
                    }
                }

                Spacer()
                    .frame(height: 5, maxWidth: .infinity)
                    .background(.separator)
                    .hoverBackground(.blue)
                    .onDrag { dx, dy in panelHeight = (panelHeight - dy).clamped(min: 80, max: 500) }
                // Problems and console
                TabView(selection: panel) {
                    Scroll {
                        VStack(spacing: 2, alignment: .leading) {
                            if problems.isEmpty {
                                HStack(spacing: 6) {
                                    Icon(.circleCheck).font(size: 12).color(.green)
                                    Text("No problems").font(size: 12).color(.secondary)
                                }
                                .padding(3)
                            }
                            for p in problems {
                                HStack(spacing: 6) {
                                    Icon(.circleX).font(size: 12).color(.red)
                                    Text("{fileName(p.file)}:{p.line}").font(size: 12).color(.secondary)
                                    Text(p.message).font(size: 12).color(.red)
                                    Spacer()
                                }
                                .padding(3)
                                .hoverBackground(.lightGray)
                                .onTap { jump(p: p) }
                            }
                        }
                        .padding(6)
                    }
                    .tabItem("Problems ({problems.count})")
                    .tag(Panel.problems)

                    Scroll {
                        VStack(spacing: 1, alignment: .leading) {
                            for text in console {
                                Text(text).font(size: 12).onTap { jumpTo(text: text) }
                            }
                        }
                        .padding(6)
                    }
                    .tabItem("Console")
                    .tag(Panel.console)

                    // The debugger: the calls that led to where the program
                    // is stopped, and the variables of the one selected.
                    HStack(spacing: 0, alignment: .top) {
                        Scroll {
                            VStack(spacing: 1, alignment: .leading) {
                                Text(debugNote).font(size: 12).color(.secondary).padding(3)
                                for (i, call) in calls.enumerated() {
                                    HStack(spacing: 6) {
                                        Text(call.name).font(size: 12, weight: if i == callShown { .bold } else { .regular })
                                        Text("{fileName(call.path)}:{call.line}").font(size: 12).color(.secondary)
                                        Spacer()
                                    }
                                    .padding(3)
                                    .background(if i == callShown { .highlight } else { .clear })
                                    .hoverBackground(.lightGray)
                                    .onTap { showCall(index: i) }
                                }
                            }
                            .padding(6)
                        }
                        .frame(width: 280)
                        Divider()
                        Scroll {
                            VStack(spacing: 1, alignment: .leading) {
                                for (i, v) in vars.enumerated() {
                                    HStack(spacing: 5) {
                                        Spacer().frame(width: Float(v.depth) * 14)
                                        if v.parts == 0 {
                                            Spacer().frame(width: 11)
                                        } else if v.open {
                                            Icon(.chevronDown).font(size: 11).color(.secondary)
                                        } else {
                                            Icon(.chevronRight).font(size: 11).color(.secondary)
                                        }
                                        Text(v.name).font(size: 12, weight: .semibold)
                                        Text(v.type).font(size: 12).color(.secondary)
                                        Text(v.value).font(size: 12)
                                        Spacer()
                                    }
                                    .padding(2)
                                    .hoverBackground(.lightGray)
                                    .onTap { toggleVar(index: i) }
                                }
                            }
                            .padding(6)
                        }
                    }
                    .tabItem("Debug")
                    .tag(Panel.debug)
                }
                .frame(height: panelHeight)
            }

            if previewOpen && isMarkdown(path: current) {
                Spacer()
                    .frame(width: 5, maxHeight: .infinity)
                    .background(.separator)
                    .hoverBackground(.blue)
                    .onDrag { dx, dy in previewWidth = (previewWidth - dx).clamped(min: 240, max: 900) }
                PreviewPanel(
                    width: previewWidth,
                    path: current,
                    text: docs.first(where: { d in d.path == current })?.text ?? "",
                    follow: { link in followPreview(link: link) },
                    close: { previewOpen = false }
                )
            }

            if designOpen {
                Spacer()
                    .frame(width: 5, maxHeight: .infinity)
                    .background(.separator)
                    .hoverBackground(.blue)
                    .onDrag { dx, dy in designWidth = (designWidth - dx).clamped(min: 300, max: 900) }
                DesignPanel(
                    width: designWidth,
                    design: design,
                    selected: designSelected,
                    ready: designReady(),
                    status: designStatus,
                    select: { index in selectDesign(index: index, show: true) },
                    change: { target, label, value in changeDesign(target: target, label: label, value: value) },
                    insert: { kind, place in insertDesign(kind: kind, place: place) },
                    move: { index, place in moveDesign(index: index, place: place) },
                    remove: { removeDesign() },
                    command: { name in commandDesign(name: name) },
                    close: { toggleDesign() }
                )
            }

            if helpOpen {
                // The edge between the editor and the Docs panel: drag it to
                // make the panel wider or narrower.
                Spacer()
                    .frame(width: 5, maxHeight: .infinity)
                    .background(.separator)
                    .hoverBackground(.blue)
                    .onDrag { dx, dy in helpWidth = (helpWidth - dx).clamped(min: 280, max: 800) }
                HelpPanel(width: helpWidth, close: { helpOpen = false })
            }
        }
    }
    .onAppear {
        reload()
        checkForUpdate()
    }

    // ----- files -----

    fn reload() {
        tree = entries(folder: project, depth: 0, expanded: expanded)
        if docs.isEmpty {
            if let first = tree.first(where: { e in !e.folder && e.name.hasSuffix(".tsl") }) {
                open(path: first.path)
            }
        }
        check()
    }

    fn choose(e: Entry) {
        selected = e.path
        if e.folder {
            if expanded.contains(e.path) {
                expanded.removeAll(where: { p in p == e.path })
            } else {
                expanded.append(e.path)
            }
            tree = entries(folder: project, depth: 0, expanded: expanded)
        } else {
            open(path: e.path)
        }
    }

    fn open(path: String) {
        let path = normalize(path: path)
        if docs.first(where: { d in d.path == path }) == nil {
            let text = readFile(path) ?? ""
            docs.append(Doc(path: path, text: text, saved: text))
        }
        current = path
        selected = path
    }

    fn closeDoc(path: String) {
        save()
        docs.removeAll(where: { d in d.path == path })
        if current == path {
            current = docs.last?.path ?? ""
        }
    }

    fn save() {
        var any = false
        for doc in docs {
            if doc.text != doc.saved {
                if writeFile(path: doc.path, text: doc.text) {
                    doc.saved = doc.text
                    any = true
                } else {
                    status = "Couldn't save {fileName(doc.path)}"
                }
            }
        }
        if any {
            status = "Saved"
            check()
        }
    }

    // ----- new, rename, delete -----

    fn ask(kind: Prompt) {
        prompt = kind
        promptText = if kind == Prompt.rename { fileName(selected) } else { "" }
    }

    fn promptLabel() -> String {
        match prompt {
            .newFile -> "New file name"
            .newFolder -> "New folder name"
            .rename -> "New name"
            _ -> ""
        }
    }

    // The folder new files go in: the selected folder, or the selected file's folder.
    fn targetFolder() -> String {
        if selected == "" {
            return project
        }
        if isFolder(selected) { selected } else { parentOf(path: selected) }
    }

    fn confirm() {
        let name = promptText.trim()
        match prompt {
            .newFile -> {
                if name != "" {
                    let file = if name.contains(".") { name } else { "{name}.tsl" }
                    let path = join(folder: targetFolder(), name: file)
                    if writeFile(path: path, text: "") {
                        refreshTree(showing: parentOf(path: path))
                        open(path: path)
                    }
                }
            }
            .newFolder -> {
                if name != "" {
                    let path = join(folder: targetFolder(), name: name)
                    if createFolder(path) {
                        refreshTree(showing: path)
                        selected = path
                    }
                }
            }
            .rename -> {
                if name != "" && selected != "" {
                    let path = join(folder: parentOf(path: selected), name: name)
                    if renameFile(from: selected, to: path) {
                        for doc in docs {
                            if doc.path == selected {
                                doc.path = path
                            }
                        }
                        if current == selected {
                            current = path
                        }
                        selected = path
                        refreshTree(showing: parentOf(path: path))
                    }
                }
            }
            .delete -> {
                if deleteFile(selected) {
                    docs.removeAll(where: { d in d.path == selected })
                    if current == selected {
                        current = docs.last?.path ?? ""
                    }
                    selected = ""
                    refreshTree(showing: project)
                } else {
                    status = "Only files can be deleted"
                }
            }
            .none -> {}
        }
        prompt = Prompt.none
        promptText = ""
    }

    fn refreshTree(showing: String) {
        if showing != project && !expanded.contains(showing) {
            expanded.append(showing)
        }
        tree = entries(folder: project, depth: 0, expanded: expanded)
    }

    // ----- check, run, build -----

    fn check() {
        problems = []
        runCommand(path: tesselCommand(), args: ["check", project, "--format", "lines"], onOutput: { text in
            if let p = parseProblem(text: text) {
                problems.append(p)
            }
        }) { code in
            status = if code == 0 {
                "No problems"
            } else if !problems.isEmpty {
                "{problems.count} problem(s)"
            } else if hasTesselFiles() {
                "Check failed"
            } else {
                "No Tessel files yet"
            }
        }
    }

    fn hasTesselFiles() -> Bool {
        (listFolder(project) ?? []).first(where: { n in n.hasSuffix(".tsl") }) != nil
    }

    // A project to start from, in the open folder: `tessel new` writes its
    // files (a program, tessel.toml, a README and a .gitignore).
    fn createProject(template: String) {
        console = []
        status = "Creating…"
        runCommand(path: tesselCommand(), args: ["new", project, "--template", template], onOutput: { text in console.append(text) }) { code in
            if code != 0 {
                panel = Panel.console
                status = "Couldn't create the project"
                return
            }
            status = "Ready"
            refreshTree(showing: project)
            open(path: join(folder: project, name: "main.tsl"))
            check()
        }
    }

    // With "Reload on save", `tessel run --hot` runs the program: when its
    // files are saved, an app takes its new code and keeps its state, and a
    // program without a window starts again. Otherwise, builds into the
    // project folder and runs the program directly. Either way, Stop can end it.
    fn runOrStop() {
        if let id = running {
            stopCommand(id)
            return
        }
        save()
        console = []
        panel = Panel.console
        if reloadOnSave {
            status = "Running"
            running = runCommand(path: tesselCommand(), args: ["run", project, "--hot"], onOutput: { text in console.append(text) }) { exitCode in
                console.append("— exited with code {exitCode}")
                running = nil
                status = "Ready"
            }
            return
        }
        status = "Building…"
        let exe = join(folder: project, name: ".tessel-run")
        runCommand(path: tesselCommand(), args: ["build", project, "-o", exe], onOutput: { text in
            console.append(text)
        }) { code in
            if code != 0 {
                status = "Build failed"
                return
            }
            console = []
            status = "Running"
            running = runCommand(path: exe, onOutput: { text in console.append(text) }) { exitCode in
                console.append("— exited with code {exitCode}")
                running = nil
                status = "Ready"
            }
        }
    }

    // ----- debugging -----

    // Starts the program in the debugger, or stops the one being debugged.
    // `tessel debug --lines` says what happens a line at a time (see
    // `debugHeard`), and is told what to do the same way (`debugSend`).
    fn debugOrStop() {
        if let id = debugging {
            stopCommand(id)
            return
        }
        if running != nil {
            return
        }
        save()
        console = []
        calls = []
        vars = []
        asked = []
        debugStopped = false
        debugNote = "Building…"
        panel = Panel.debug
        status = "Building…"
        debugging = runCommand(path: tesselCommand(), args: ["debug", project, "--lines"], input: true, onOutput: { text in debugHeard(text) }) { code in
            debugging = nil
            debugStopped = false
            calls = []
            vars = []
            debugNote = "The program ended."
            console.append("— exited with code {code}")
            status = "Ready"
        }
    }

    fn debugSend(text: String) {
        if let id = debugging {
            sendToCommand(id, text: text)
        }
    }

    // A line from the debugger.
    fn debugHeard(text: String) {
        let f = text.split("\t")
        match f[0] {
            "output" -> console.append(text.substring(from: 7, to: text.count))
            // The program is built, and waits: it's told where to stop, then to run.
            "ready" -> {
                for path in breakpointFiles() {
                    sendBreakpoints(path: path)
                }
                debugSend("run")
                debugNote = "Running. The program stops at the red dots: click beside a line to add one."
                status = "Debugging"
            }
            "failed" -> {
                panel = Panel.console
                status = "Build failed"
            }
            "running" -> {
                debugStopped = false
                calls = []
                vars = []
                asked = []
                debugNote = "Running."
            }
            "frames" -> { callsComing = [] }
            "frame" -> {
                if let call = parseDebugCall(text: text) {
                    callsComing.append(call)
                }
            }
            "stopped" -> {
                calls = callsComing
                debugStopped = true
                panel = Panel.debug
                debugNote = match f[1] {
                    "breakpoint" -> "Stopped at a breakpoint."
                    "error" -> "Stopped where an error happened: {if f.count > 2 { f[2] } else { "" }}"
                    "pause" -> "Paused."
                    _ -> "Stopped."
                }
                vars = []
                asked = []
                showCall(index: 0)
            }
            "vars" -> { varsComing = [] }
            "var" -> {
                if let v = parseDebugVar(text: text, depth: 0) {
                    varsComing.append(v)
                }
            }
            "end" -> debugVarsCame()
            _ -> {}
        }
    }

    // Looks at one of the calls: its line in the editor, and its variables.
    fn showCall(index: Int) {
        if index >= calls.count {
            return
        }
        callShown = index
        let call = calls[index]
        jump(p: Problem(file: call.path, line: call.line, column: 1, message: ""))
        vars = []
        asked.append(-1)
        debugSend("vars\t{index}")
    }

    // Shows or hides the parts of the variable in row `index`.
    fn toggleVar(index: Int) {
        if index >= vars.count || vars[index].parts == 0 || !debugStopped {
            return
        }
        if vars[index].open {
            // (Its parts are the rows after it that are further in.)
            let depth = vars[index].depth
            while index + 1 < vars.count && vars[index + 1].depth > depth {
                vars.remove(at: index + 1)
            }
            vars[index].open = false
            return
        }
        vars[index].open = true
        asked.append(vars[index].parts)
        debugSend("children\t{vars[index].parts}")
    }

    // The variables asked for arrived: a call's, or the parts of a row.
    fn debugVarsCame() {
        if asked.isEmpty {
            return
        }
        let parts = asked.remove(at: 0)
        if parts < 0 {
            vars = varsComing
            return
        }
        for (i, v) in vars.enumerated() {
            if v.parts == parts && v.open {
                var at = i + 1
                for part in varsComing {
                    var row = part
                    row.depth = v.depth + 1
                    vars.insert(row, at: at)
                    at += 1
                }
                if v.count > varsComing.count {
                    vars.insert(DebugVar(name: "…", type: "", value: "{v.count} in all", parts: 0, count: 0, depth: v.depth + 1), at: at)
                }
                return
            }
        }
    }

    fn breakpointLines(path: String) -> [Int] {
        breakpoints.filter { b in b.path == path }.map { b in b.line }
    }

    fn breakpointFiles() -> [String] {
        var files: [String] = []
        for b in breakpoints {
            if !files.contains(b.path) {
                files.append(b.path)
            }
        }
        files
    }

    // A click beside a line: a breakpoint there, or no more.
    fn toggleBreakpoint(path: String, line: Int) {
        if breakpoints.first(where: { b in b.path == path && b.line == line }) == nil {
            breakpoints.append(Breakpoint(path: path, line: line))
        } else {
            breakpoints.removeAll(where: { b in b.path == path && b.line == line })
        }
        sendBreakpoints(path: path)
    }

    fn sendBreakpoints(path: String) {
        let lines = breakpointLines(path: path).map { l in "{l}" }.joined(separator: ",")
        debugSend("breakpoints\t{path}\t{lines}")
    }

    // The line the program is stopped on in a file, for its editor (0: none).
    fn stoppedLine(path: String) -> Int {
        if !debugStopped || callShown >= calls.count || calls[callShown].path != path {
            return 0
        }
        calls[callShown].line
    }

    fn build(bundle: Bool) {
        save()
        console = []
        panel = Panel.console
        var args = ["build", project, "-o", join(folder: project, name: fileName(project))]
        if bundle {
            args.append("--bundle")
        }
        status = "Building…"
        runCommand(path: tesselCommand(), args: args, onOutput: { text in console.append(text) }) { code in
            status = if code == 0 { "Built" } else { "Build failed" }
        }
    }

    // ----- design -----

    // (The Preview, Design and Docs panels take turns next to the editor.)
    fn toggleHelp() {
        helpOpen = !helpOpen
        if helpOpen {
            previewOpen = false
            if designOpen {
                toggleDesign()
            }
        }
    }

    fn togglePreview() {
        previewOpen = !previewOpen
        if previewOpen {
            helpOpen = false
            if designOpen {
                toggleDesign()
            }
        }
    }

    // A link in a previewed file: a place on the web (in the browser), or
    // another file of the project (in the editor).
    fn followPreview(link: String) {
        if link.hasPrefix("http://") || link.hasPrefix("https://") || link.hasPrefix("mailto:") {
            openURL(link)
            return
        }
        // (Without the part after `#`, which names a heading.)
        let file = link.split("#")[0]
        if file == "" {
            return
        }
        let path = join(folder: parentOf(path: current), name: file)
        if fileExists(path) && !isFolder(path) {
            open(path: path)
        } else {
            status = "No file {file}"
        }
    }

    fn toggleDesign() {
        designOpen = !designOpen
        if designOpen {
            helpOpen = false
            previewOpen = false
            refreshDesign()
            // Keeps the picture up to date with the code, and the selection
            // with the cursor.
            designTimer = every(seconds: 0.5) { designTick() }
        } else {
            stopTimer(designTimer)
        }
    }

    fn designTexts() -> [DesignText] {
        docs.map { d in DesignText(path: d.path, text: d.text) }
    }

    // Whether the picture was made from the code as it is now.
    fn designFresh() -> Bool {
        for d in docs {
            if let seen = designSeen.first(where: { s in s.path == d.path }) {
                if seen.text != d.text {
                    return false
                }
            } else if d.text != d.saved {
                return false
            }
        }
        true
    }

    // Whether views can be changed in the picture.
    fn designReady() -> Bool {
        design.picture != "" && !designRunning && !designFailed && designFresh()
    }

    fn designTick() {
        // The view the cursor is in gets selected.
        if let d = docs.first(where: { d in d.path == current }) {
            let caret = "{d.path}:{d.line}"
            if caret != designCaret {
                designCaret = caret
                if designReady() {
                    let at = designViewAt(d: design, path: d.path, line: d.line)
                    if at >= 0 {
                        selectDesign(index: at, show: false)
                    }
                }
            }
        }
        // A new picture, once the code has stopped changing for a moment.
        let now = designTexts()
        let settled = now == designLast
        if !settled {
            designLast = now
        }
        if settled && !designRunning && !designFresh() {
            refreshDesign()
        }
    }

    // Makes the picture again, from the text in the editor (saved or not).
    fn refreshDesign() {
        if designRunning {
            return
        }
        designRunning = true
        designRequest += 1
        let prefix = joinPath(tempFolder(), "tessel-design-{designSession}-{designRequest}")
        let texts = designTexts()
        var args = ["preview", project, "--out", prefix]
        if isDarkMode() {
            args.append("--dark")
        }
        var unsaved: [String] = []
        for (i, d) in docs.enumerated() {
            if d.text != d.saved {
                let file = "{prefix}-{i}.tsl"
                if writeFile(path: file, text: d.text) {
                    args.append("--text")
                    args.append(d.path)
                    args.append(file)
                    unsaved.append(file)
                }
            }
        }
        var problem = ""
        runCommand(path: tesselCommand(), args: args, onOutput: { line in
            if problem == "" && line.hasPrefix("error") {
                problem = line
            }
        }) { code in
            for file in unsaved {
                deleteFile(file)
            }
            designRunning = false
            designSeen = texts
            let made: Design? = if code == 0 { designLoad(prefix: prefix, seen: texts) } else { nil }
            if let made = made {
                designDiscard(picture: design.picture)
                design = made
                designFailed = false
                designStatus = ""
                designSelected = designFind(d: design, path: designPath, lo: designLo)
            } else {
                designDiscard(picture: "{prefix}.png")
                designFailed = true
                designStatus = if problem == "" { "No preview: the app couldn't be shown" } else { "No new preview: {problem}" }
            }
        }
    }

    // Selects a view of the picture (-1 for none); with `show`, the editor
    // goes to where it's written.
    fn selectDesign(index: Int, show: Bool) {
        designSelected = index
        if index < 0 || index >= design.views.count {
            designLo = -1
            return
        }
        let v = design.views[index]
        designPath = design.files[v.file]
        designLo = v.lo
        if show {
            open(path: designPath)
            for doc in docs {
                if doc.path == designPath {
                    doc.line = v.line
                }
            }
            designCaret = "{designPath}:{v.line}"
        }
    }

    // Puts a file's new text in the editor, and makes the picture again.
    // The view that starts at `lo` is then selected.
    fn applyDesign(path: String, text: String, lo: Int) {
        open(path: path)
        for doc in docs {
            if doc.path == path {
                doc.text = text
            }
        }
        designPath = path
        designLo = lo
        designLast = designTexts()
        refreshDesign()
    }

    fn changeDesign(target: String, label: String, value: String) {
        if !designReady() || designSelected < 0 {
            return
        }
        let v = design.views[designSelected]
        let text = designSet(text: design.texts[v.file], item: v, target: target, label: label, value: value)
        if text != design.texts[v.file] {
            applyDesign(path: design.files[v.file], text: text, lo: v.lo)
        }
    }

    fn insertDesign(kind: Int, place: DesignPlace) {
        let anchor = max(place.container, max(place.before, place.after))
        if !designReady() || anchor < 0 {
            return
        }
        let file = design.views[anchor].file
        let change = designInsertItem(d: design, file: file, place: place, item: designItems()[kind])
        if change.ok {
            applyDesign(path: design.files[file], text: change.text, lo: change.lo)
        } else {
            designStatus = "A {designItems()[kind].label} can only go in a view or app, where its state can be"
        }
    }

    fn moveDesign(index: Int, place: DesignPlace) {
        if !designReady() {
            return
        }
        let change = designMove(d: design, moved: index, place: place)
        if change.ok {
            applyDesign(path: design.files[design.views[index].file], text: change.text, lo: change.lo)
        }
    }

    // Copy, cut, paste or duplicate, for the selected view. What's copied
    // is the view's code, so it can be pasted in the editor too; what's
    // pasted goes into the selected stack, or after the selected view.
    fn commandDesign(name: String) {
        if !designReady() || designSelected < 0 {
            return
        }
        let v = design.views[designSelected]
        let code = designCode(text: design.texts[v.file], item: v)
        if name == "copy" || name == "cut" {
            copyToClipboard(code)
            designStatus = ""
            if name == "cut" {
                removeDesign()
            }
            return
        }
        let pasted = if name == "paste" { (clipboardText() ?? "").trim() } else { code }
        if pasted == "" {
            return
        }
        let place = if name == "paste" && v.blockLo >= 0 { DesignPlace(container: designSelected) } else { DesignPlace(after: designSelected) }
        let change = designInsert(d: design, file: v.file, place: place, code: pasted)
        if change.ok {
            applyDesign(path: design.files[v.file], text: change.text, lo: change.lo)
        }
    }

    fn removeDesign() {
        if !designReady() || designSelected < 0 {
            return
        }
        let v = design.views[designSelected]
        applyDesign(path: design.files[v.file], text: designRemove(text: design.texts[v.file], item: v), lo: -1)
    }

    // ----- updates -----

    // Asks `tessel update --check` whether there's a newer Tessel.
    fn checkForUpdate() {
        if environment("TESSEL_NO_UPDATE_CHECK") != nil {
            return
        }
        runCommand(path: tesselCommand(), args: ["update", "--check"], onOutput: { line in
            // "Tessel v0.1.3 is available (you have v0.1.2). …"
            if line.hasPrefix("Tessel v") && line.contains(" is available") {
                newVersion = line.split(" ")[1]
            }
        }) { code in }
    }

    fn updateTessel() {
        save()
        updating = true
        console = []
        panel = Panel.console
        status = "Updating Tessel…"
        runCommand(path: tesselCommand(), args: ["update"], onOutput: { text in console.append(text) }) { code in
            updating = false
            if code == 0 {
                status = "Updated to {newVersion}: restart Tessel to use it"
                newVersion = ""
            } else {
                status = "Update failed"
            }
        }
    }

    // ----- code completion -----

    // Asks `tessel complete` what fits at `offset`, with the unsaved text.
    // Only the latest request's answer is used.
    fn complete(path: String, offset: Int) {
        let text = docs.first(where: { d in d.path == path })?.text ?? ""
        suggestRequest += 1
        let request = suggestRequest
        let file = joinPath(tempFolder(), "tessel-complete-{request}.tsl")
        if !writeFile(path: file, text: text) {
            return
        }
        var found: [Completion] = []
        var start = -1
        runCommand(path: tesselCommand(), args: ["complete", path, "{offset}", "--text", file], onOutput: { line in
            if line.hasPrefix("start ") {
                start = Int(line.substring(from: 6, to: line.count)) ?? -1
            } else if let c = parseCompletion(text: line) {
                found.append(c)
            }
        }) { code in
            deleteFile(file)
            if request == suggestRequest {
                suggestions = found
                suggestStart = start
                suggestPath = path
            }
        }
    }

    // ----- errors -----

    fn jump(p: Problem) {
        open(path: p.file)
        for doc in docs {
            if doc.path == p.file {
                doc.line = p.line
            }
        }
    }

    fn jumpTo(text: String) {
        if let p = parseLocation(text: text) {
            jump(p: p)
        }
    }

    fn errorLines(path: String) -> [Int] {
        problems.filter { p in p.file == path }.map { p in p.line }
    }
}
