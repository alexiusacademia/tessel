// Files, paths, the folder tree, and reading the output of `tessel`.

struct Problem {
    file: String
    line: Int
    column: Int
    message: String
}

// A row in the explorer.
struct Entry {
    path: String
    name: String
    depth: Int
    folder: Bool
}

// An open file (a tab in the editor).
struct Doc {
    path: String
    text: String
    saved: String
    line: Int = 1
}

enum Panel { problems, console }

enum Prompt { none, newFile, newFolder, rename, delete }

// The `tessel` command. `tessel` sets TESSEL_EXE when it starts the IDE.
fn tesselCommand() -> String {
    environment("TESSEL_EXE") ?? "tessel"
}

fn fileName(path: String) -> String {
    path.replace("\\", with: "/").split("/").last ?? path
}

fn parentOf(path: String) -> String {
    var parts = path.replace("\\", with: "/").split("/")
    if parts.count > 1 {
        parts.remove(at: parts.count - 1)
    }
    parts.joined(separator: "/")
}

fn join(folder: String, name: String) -> String {
    normalize(path: "{folder}/{name}")
}

// Paths always use "/" (Windows accepts it too), so the same file always has
// the same path and paths can be compared as strings.
fn normalize(path: String) -> String {
    path.replace("\\", with: "/")
}

// The explorer's visible rows: folders first, then files; expanded folders
// show their contents indented. Hidden files (starting with ".") are skipped.
fn entries(folder: String, depth: Int, expanded: [String]) -> [Entry] {
    let names = (listFolder(folder) ?? []).filter { n in !n.hasPrefix(".") }
    var folders: [Entry] = []
    var files: [Entry] = []
    for name in names {
        let path = join(folder: folder, name: name)
        if isFolder(path) {
            folders.append(Entry(path: path, name: name, depth: depth, folder: true))
            if expanded.contains(path) {
                folders = folders + entries(folder: path, depth: depth + 1, expanded: expanded)
            }
        } else {
            files.append(Entry(path: path, name: name, depth: depth, folder: false))
        }
    }
    folders + files
}

// A line of `tessel check --format lines`:
// file, line, column, end line, end column, message (tab-separated).
fn parseProblem(text: String) -> Problem? {
    let f = text.split("\t")
    if f.count != 6 {
        return nil
    }
    Problem(file: normalize(path: f[0]), line: Int(f[1]) ?? 1, column: Int(f[2]) ?? 1, message: f[5])
}

// ` --> file:line:column`, as printed by compile and runtime errors.
fn parseLocation(text: String) -> Problem? {
    let t = text.trim()
    if !t.hasPrefix("--> ") {
        return nil
    }
    let parts = t.substring(from: 4, to: t.count).split(":")
    if parts.count < 3 {
        return nil
    }
    // A Windows path has a `:` too (C:\...), so the file is everything
    // before the last two parts.
    var file = parts[0]
    for i in 1..parts.count - 2 {
        file += ":" + parts[i]
    }
    let line = Int(parts[parts.count - 2]) ?? 1
    let column = Int(parts[parts.count - 1]) ?? 1
    Problem(file: normalize(path: file), line: line, column: column, message: "")
}
