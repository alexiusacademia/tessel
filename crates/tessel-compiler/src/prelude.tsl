// The prelude: declarations every Tessel program has. A program can declare
// its own `Error` or `Result` instead (then none of this is included), or
// its own function with one of these names (then that one isn't).

/// Why something failed.
struct Error {
    message: String
}

/// A value, or the reason there isn't one. `try` gives the value, or passes
/// the failure on.
enum Result<T> {
    ok(value: T)
    failure(error: Error)

    /// The value, or nil if it failed.
    fn value() -> T? {
        match self {
            .ok(v) -> v
            .failure(_) -> nil
        }
    }

    /// Why it failed, or nil if it worked.
    fn error() -> Error? {
        match self {
            .ok(_) -> nil
            .failure(e) -> e
        }
    }

    fn isOk() -> Bool {
        match self {
            .ok(_) -> true
            .failure(_) -> false
        }
    }

    /// The value, or `fallback` if it failed.
    fn valueOr(_ fallback: T) -> T {
        match self {
            .ok(v) -> v
            .failure(_) -> fallback
        }
    }
}

/// The text of a file, or why it couldn't be read.
fn readText(_ path: String) -> Result<String> {
    __clearError()
    if let text = readFile(path) {
        return Result.ok(value: text)
    }
    Result.failure(error: Error(message: __lastError()))
}

/// Writes text to a file (replacing it): nil if it worked, else why not.
fn writeText(path: String, text: String) -> Error? {
    __clearError()
    if writeFile(path: path, text: text) {
        return nil
    }
    Error(message: __lastError())
}

/// Adds text to the end of a file (creating it): nil if it worked, else why not.
fn appendText(path: String, text: String) -> Error? {
    __clearError()
    if appendFile(path: path, text: text) {
        return nil
    }
    Error(message: __lastError())
}

/// The bytes of a file, or why it couldn't be read.
fn readBytes(_ path: String) -> Result<Data> {
    __clearError()
    if let data = readData(path) {
        return Result.ok(value: data)
    }
    Result.failure(error: Error(message: __lastError()))
}

/// Writes bytes to a file: nil if it worked, else why not.
fn writeBytes(path: String, data: Data) -> Error? {
    __clearError()
    if writeData(path: path, data: data) {
        return nil
    }
    Error(message: __lastError())
}

/// A whole number from text, or why it isn't one.
fn parseInt(_ text: String) -> Result<Int> {
    if let n = Int(text.trim()) {
        return Result.ok(value: n)
    }
    Result.failure(error: Error(message: "\"{text}\" isn't a whole number"))
}

/// A number from text, or why it isn't one.
fn parseFloat(_ text: String) -> Result<Float> {
    if let x = Float(text.trim()) {
        return Result.ok(value: x)
    }
    Result.failure(error: Error(message: "\"{text}\" isn't a number"))
}

/// A value read from JSON, or why it couldn't be.
fn decodeJson<T>(_ text: String) -> Result<T> {
    __clearError()
    let decoded: T? = fromJson(text)
    if let value = decoded {
        return Result.ok(value: value)
    }
    let why = __lastError()
    Result.failure(error: Error(message: if why == "" { "the JSON doesn't have the shape of this type" } else { why }))
}

/// A value read from binary data (made by `toBinary`), or why it couldn't be.
fn decodeBinary<T>(_ data: Data) -> Result<T> {
    __clearError()
    let decoded: T? = fromBinary(data)
    if let value = decoded {
        return Result.ok(value: value)
    }
    let why = __lastError()
    Result.failure(error: Error(message: if why == "" { "the data doesn't have the shape of this type" } else { why }))
}

/// What the calendar and the clock say at one moment, in one time zone.
struct DateParts {
    year: Int
    /// 1 for January to 12.
    month: Int
    day: Int
    hour: Int
    minute: Int
    second: Int
    /// 1 for Monday to 7 for Sunday.
    weekday: Int
    /// 1 for 1 January.
    dayOfYear: Int
}

/// The date and time of day of a moment (see `now`), in the computer's time
/// zone or the one named. All zeros for a time zone that doesn't exist.
fn dateParts(_ time: Float, timeZone: String = "") -> DateParts {
    let p = __dateParts(time, timeZone)
    DateParts(year: p[0], month: p[1], day: p[2], hour: p[3], minute: p[4], second: p[5], weekday: p[6], dayOfYear: p[7])
}

/// The width and height in pixels of a PNG or JPEG file, or nil if it
/// can't be read as one.
fn imageSize(_ path: String) -> (Int, Int)? {
    let size = __imageSize(path)
    if size.count < 2 {
        return nil
    }
    (size[0], size[1])
}

/// A PNG or JPEG file's width, height and pixels (row by row from the top
/// left, each as `writeImage` takes them), or nil if it can't be read as
/// a picture.
fn readImage(_ path: String) -> (Int, Int, [Int])? {
    let size = __imageSize(path)
    if size.count < 2 {
        return nil
    }
    let pixels = __imagePixels(path)
    if pixels.count != size[0] * size[1] {
        return nil
    }
    (size[0], size[1], pixels)
}

/// What the app's `tessel.toml` says about it (its `[app]` table), with
/// defaults for what it leaves out: the name of the `app`, version "1.0".
struct AppInfo {
    name: String
    id: String
    version: String
    build: String
    description: String
    author: String
    copyright: String
}

/// The app's name, version and the rest, from its `tessel.toml`.
fn appInfo() -> AppInfo {
    let f = __appInfo()
    if f.count < 7 {
        return AppInfo(name: "", id: "", version: "", build: "", description: "", author: "", copyright: "")
    }
    AppInfo(name: f[0], id: f[1], version: f[2], build: f[3], description: f[4], author: f[5], copyright: f[6])
}

// ===== databases =====

/// A value in a database: what a column of a row holds, or a value given
/// for a `?` in SQL. Where one is wanted, an `Int`, `Float`, `String`,
/// `Bool` (stored as 1 or 0) or `Data` can be given as it is, and an
/// optional one too (`nil` is `.null`).
enum SqlValue {
    null
    int(value: Int)
    float(value: Float)
    text(value: String)
    data(value: Data)
}

/// A SQLite database file, opened with `openDatabase`.
struct Database {
    id: Int

    /// Runs SQL that changes the database (`CREATE TABLE`, `INSERT`,
    /// `UPDATE`, `DELETE`, …), with `values` for its `?`s. SQL without
    /// values can be several statements, separated by `;`. Returns how many
    /// rows the last statement changed.
    fn execute(_ sql: String, _ values: [SqlValue] = []) -> Result<Int> {
        __clearError()
        let changed = __dbExecute(id, sql, toJson(values))
        if changed < 0 {
            return Result.failure(error: Error(message: __lastError()))
        }
        Result.ok(value: changed)
    }

    /// Runs a `SELECT`, with `values` for its `?`s: its rows.
    fn query(_ sql: String, _ values: [SqlValue] = []) -> Result<[DatabaseRow]> {
        __clearError()
        if let json = __dbQuery(id, sql, toJson(values)) {
            if let table: __DatabaseTable = fromJson(json) {
                var rows: [DatabaseRow] = []
                for cells in table.rows {
                    rows.append(DatabaseRow(columns: table.columns, values: cells))
                }
                return Result.ok(value: rows)
            }
        }
        Result.failure(error: Error(message: __lastError()))
    }

    /// The row number (`rowid`) of the row the last `INSERT` added.
    fn lastInsertId() -> Int {
        __dbLastInsertId(id)
    }

    /// Closes the database. (It's closed when the program ends, too.)
    fn close() {
        __dbClose(id)
    }
}

/// A row a query found: its columns' names, and their values.
struct DatabaseRow {
    columns: [String]
    values: [SqlValue]

    /// The value of a column (by its name in the query). A name the row
    /// doesn't have stops the program.
    fn value(_ column: String) -> SqlValue {
        for (i, name) in columns.enumerated() {
            if name == column {
                return values[i]
            }
        }
        __dbNoColumn(column, columns)
        SqlValue.null
    }

    /// A column as an `Int`: a number, text of one, or 0.
    fn int(_ column: String) -> Int {
        match value(column) {
            .int(v) -> v
            .float(v) -> Int(v)
            .text(t) -> parseInt(t).valueOr(0)
            _ -> 0
        }
    }

    /// A column as a `Float`: a number, text of one, or 0.
    fn float(_ column: String) -> Float {
        match value(column) {
            .int(v) -> Float(v)
            .float(v) -> v
            .text(t) -> parseFloat(t).valueOr(0.0)
            _ -> 0.0
        }
    }

    /// A column as text (empty for null).
    fn text(_ column: String) -> String {
        match value(column) {
            .text(t) -> t
            .int(v) -> "{v}"
            .float(v) -> "{v}"
            .data(d) -> d.text ?? ""
            .null -> ""
        }
    }

    /// A column as a `Bool`: true when it's a number that isn't 0.
    fn bool(_ column: String) -> Bool {
        int(column) != 0
    }

    /// A column as bytes (a blob, or text's bytes).
    fn data(_ column: String) -> Data {
        match value(column) {
            .data(d) -> d
            .text(t) -> Data(text: t)
            _ -> Data()
        }
    }

    /// Whether a column is null.
    fn isNull(_ column: String) -> Bool {
        match value(column) {
            .null -> true
            _ -> false
        }
    }
}

/// A query's result, as the runtime gives it.
struct __DatabaseTable {
    columns: [String]
    rows: [[SqlValue]]
}

/// Opens (or creates) a SQLite database file. `":memory:"` is a database
/// that lives only while the program runs.
fn openDatabase(_ path: String) -> Result<Database> {
    __clearError()
    let id = __dbOpen(path)
    if id < 0 {
        return Result.failure(error: Error(message: __lastError()))
    }
    Result.ok(value: Database(id: id))
}

// What a value given where a `SqlValue` is wanted becomes (see the checker).
fn __sqlInt(_ v: Int) -> SqlValue { SqlValue.int(value: v) }
fn __sqlFloat(_ v: Float) -> SqlValue { SqlValue.float(value: v) }
fn __sqlText(_ v: String) -> SqlValue { SqlValue.text(value: v) }
fn __sqlBool(_ v: Bool) -> SqlValue { SqlValue.int(value: if v { 1 } else { 0 }) }
fn __sqlData(_ v: Data) -> SqlValue { SqlValue.data(value: v) }
fn __sqlOptInt(_ v: Int?) -> SqlValue {
    if let x = v {
        return __sqlInt(x)
    }
    SqlValue.null
}
fn __sqlOptFloat(_ v: Float?) -> SqlValue {
    if let x = v {
        return __sqlFloat(x)
    }
    SqlValue.null
}
fn __sqlOptText(_ v: String?) -> SqlValue {
    if let x = v {
        return __sqlText(x)
    }
    SqlValue.null
}
fn __sqlOptBool(_ v: Bool?) -> SqlValue {
    if let x = v {
        return __sqlBool(x)
    }
    SqlValue.null
}
fn __sqlOptData(_ v: Data?) -> SqlValue {
    if let x = v {
        return __sqlData(x)
    }
    SqlValue.null
}
