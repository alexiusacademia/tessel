// The prelude: declarations every Tessel program has. A program can declare
// its own `Error` or `Result` instead (then none of this is included), or
// its own function with one of these names (then that one isn't).

/// Why something failed.
struct Error {
    message: String
}

/// A value, or the reason there isn't one. `try` gives the value, or passes
/// the failure on.
enum Result<T> {
    ok(value: T)
    failure(error: Error)

    /// The value, or nil if it failed.
    fn value() -> T? {
        match self {
            .ok(v) -> v
            .failure(_) -> nil
        }
    }

    /// Why it failed, or nil if it worked.
    fn error() -> Error? {
        match self {
            .ok(_) -> nil
            .failure(e) -> e
        }
    }

    fn isOk() -> Bool {
        match self {
            .ok(_) -> true
            .failure(_) -> false
        }
    }

    /// The value, or `fallback` if it failed.
    fn valueOr(_ fallback: T) -> T {
        match self {
            .ok(v) -> v
            .failure(_) -> fallback
        }
    }
}

/// The text of a file, or why it couldn't be read.
fn readText(_ path: String) -> Result<String> {
    __clearError()
    if let text = readFile(path) {
        return Result.ok(value: text)
    }
    Result.failure(error: Error(message: __lastError()))
}

/// Writes text to a file (replacing it): nil if it worked, else why not.
fn writeText(path: String, text: String) -> Error? {
    __clearError()
    if writeFile(path: path, text: text) {
        return nil
    }
    Error(message: __lastError())
}

/// Adds text to the end of a file (creating it): nil if it worked, else why not.
fn appendText(path: String, text: String) -> Error? {
    __clearError()
    if appendFile(path: path, text: text) {
        return nil
    }
    Error(message: __lastError())
}

/// The bytes of a file, or why it couldn't be read.
fn readBytes(_ path: String) -> Result<Data> {
    __clearError()
    if let data = readData(path) {
        return Result.ok(value: data)
    }
    Result.failure(error: Error(message: __lastError()))
}

/// Writes bytes to a file: nil if it worked, else why not.
fn writeBytes(path: String, data: Data) -> Error? {
    __clearError()
    if writeData(path: path, data: data) {
        return nil
    }
    Error(message: __lastError())
}

/// A whole number from text, or why it isn't one.
fn parseInt(_ text: String) -> Result<Int> {
    if let n = Int(text.trim()) {
        return Result.ok(value: n)
    }
    Result.failure(error: Error(message: "\"{text}\" isn't a whole number"))
}

/// A number from text, or why it isn't one.
fn parseFloat(_ text: String) -> Result<Float> {
    if let x = Float(text.trim()) {
        return Result.ok(value: x)
    }
    Result.failure(error: Error(message: "\"{text}\" isn't a number"))
}

/// A value read from JSON, or why it couldn't be.
fn decodeJson<T>(_ text: String) -> Result<T> {
    __clearError()
    let decoded: T? = fromJson(text)
    if let value = decoded {
        return Result.ok(value: value)
    }
    let why = __lastError()
    Result.failure(error: Error(message: if why == "" { "the JSON doesn't have the shape of this type" } else { why }))
}

/// A value read from binary data (made by `toBinary`), or why it couldn't be.
fn decodeBinary<T>(_ data: Data) -> Result<T> {
    __clearError()
    let decoded: T? = fromBinary(data)
    if let value = decoded {
        return Result.ok(value: value)
    }
    let why = __lastError()
    Result.failure(error: Error(message: if why == "" { "the data doesn't have the shape of this type" } else { why }))
}

/// What the calendar and the clock say at one moment, in one time zone.
struct DateParts {
    year: Int
    /// 1 for January to 12.
    month: Int
    day: Int
    hour: Int
    minute: Int
    second: Int
    /// 1 for Monday to 7 for Sunday.
    weekday: Int
    /// 1 for 1 January.
    dayOfYear: Int
}

/// The date and time of day of a moment (see `now`), in the computer's time
/// zone or the one named. All zeros for a time zone that doesn't exist.
fn dateParts(_ time: Float, timeZone: String = "") -> DateParts {
    let p = __dateParts(time, timeZone)
    DateParts(year: p[0], month: p[1], day: p[2], hour: p[3], minute: p[4], second: p[5], weekday: p[6], dayOfYear: p[7])
}

/// The width and height in pixels of a PNG or JPEG file, or nil if it
/// can't be read as one.
fn imageSize(_ path: String) -> (Int, Int)? {
    let size = __imageSize(path)
    if size.count < 2 {
        return nil
    }
    (size[0], size[1])
}

/// A PNG or JPEG file's width, height and pixels (row by row from the top
/// left, each as `writeImage` takes them), or nil if it can't be read as
/// a picture.
fn readImage(_ path: String) -> (Int, Int, [Int])? {
    let size = __imageSize(path)
    if size.count < 2 {
        return nil
    }
    let pixels = __imagePixels(path)
    if pixels.count != size[0] * size[1] {
        return nil
    }
    (size[0], size[1], pixels)
}

/// What the app's `tessel.toml` says about it (its `[app]` table), with
/// defaults for what it leaves out: the name of the `app`, version "1.0".
struct AppInfo {
    name: String
    id: String
    version: String
    build: String
    description: String
    author: String
    copyright: String
}

/// The app's name, version and the rest, from its `tessel.toml`.
fn appInfo() -> AppInfo {
    let f = __appInfo()
    if f.count < 7 {
        return AppInfo(name: "", id: "", version: "", build: "", description: "", author: "", copyright: "")
    }
    AppInfo(name: f[0], id: f[1], version: f[2], build: f[3], description: f[4], author: f[5], copyright: f[6])
}

// ===== fonts =====

/// How a font is laid out at a size, in points.
struct FontMetrics {
    /// From the baseline up to the top of the tallest letters (and accents)…
    ascent: Float
    /// …and down to the bottom of the deepest (positive).
    descent: Float
    /// The room the font asks for between one line's descent and the next
    /// one's ascent.
    lineGap: Float
    /// How tall capitals are (H), and small letters without a stem (x).
    capHeight: Float
    xHeight: Float
    /// From one baseline to the next: ascent, descent and line gap.
    lineHeight: Float
}

/// The metrics of a font, as `g.text` would use it at `size`.
fn fontMetrics(size: Float, weight: Weight = .regular, italic: Bool = false, family: String = "") -> FontMetrics {
    let m = __fontMetrics(size: size, weight: weight, italic: italic, family: family)
    if m.count < 5 {
        return FontMetrics(ascent: 0, descent: 0, lineGap: 0, capHeight: 0, xHeight: 0, lineHeight: 0)
    }
    FontMetrics(ascent: m[0], descent: m[1], lineGap: m[2], capHeight: m[3], xHeight: m[4], lineHeight: m[0] + m[1] + m[2])
}

/// A glyph of a text, as it's placed after shaping (kerning and ligatures
/// done): from the text's top left corner.
struct TextGlyph {
    /// Where it starts, on its line's baseline.
    x: Float
    y: Float
    /// How far it moves the next glyph along.
    advance: Float
    /// The characters it shows, `start` up to `end` (as `substring` counts).
    /// A glyph after the first that shows the same ones (a part of an
    /// accented letter, say) has none: `start == end`.
    start: Int
    end: Int
}

/// The glyphs of a text as `g.text` places them.
fn textGlyphs(_ text: String, size: Float, weight: Weight = .regular, italic: Bool = false, family: String = "",
              kerning: Bool = true, tracking: Float = 0) -> [TextGlyph] {
    let g = __textGlyphs(text, size: size, weight: weight, italic: italic, family: family, kerning: kerning, tracking: tracking)
    var all: [TextGlyph] = []
    var at = 0
    while at + 5 <= g.count {
        all.append(TextGlyph(x: g[at], y: g[at + 1], advance: g[at + 2], start: Int(g[at + 3]), end: Int(g[at + 4])))
        at += 5
    }
    all
}

/// A face of a font family.
struct FontStyle {
    /// What the family calls it: "Light", "Bold Italic", "Condensed Black"…
    name: String
    /// The `Weight` nearest it.
    weight: Weight
    italic: Bool
}

fn __weightNear(_ w: Float) -> Weight {
    if w < 150 { return .thin }
    if w < 250 { return .ultraLight }
    if w < 350 { return .light }
    if w < 450 { return .regular }
    if w < 550 { return .medium }
    if w < 650 { return .semibold }
    if w < 750 { return .bold }
    if w < 850 { return .heavy }
    Weight.black
}

/// The faces of an installed font family, lightest first; none for a
/// family that isn't installed.
fn fontStyles(_ family: String) -> [FontStyle] {
    let names = __fontStyleNames(family)
    let kinds = __fontStyleKinds(family)
    var all: [FontStyle] = []
    for (i, name) in names.enumerated() {
        if i * 2 + 1 < kinds.count {
            all.append(FontStyle(name: name, weight: __weightNear(kinds[i * 2]), italic: kinds[i * 2 + 1] != 0))
        }
    }
    all
}

// ===== where the device is, its satellites and its compass =====

/// What a program has to be allowed by the user before it can do it.
enum Permission {
    /// Knowing where the device is, as exactly as it can tell.
    location
    /// Knowing about where it is (to a few kilometers).
    approximateLocation
}

fn __permissionKind(_ permission: Permission) -> Int {
    match permission {
        .location -> 0
        .approximateLocation -> 1
    }
}

/// Whether the user has allowed it.
fn hasPermission(_ permission: Permission) -> Bool {
    __permission(__permissionKind(permission), false) == 1
}

/// Asks the user to allow it, if they haven't said yet, and waits for the
/// answer: whether they have.
async fn requestPermission(_ permission: Permission) -> Bool {
    let kind = __permissionKind(permission)
    var answer = __permission(kind, true)
    while answer == 2 {
        await after(seconds: 0.1)
        answer = __permission(kind, false)
    }
    answer == 1
}

fn __known(_ number: Float) -> Float? {
    if number.isNaN {
        return nil
    }
    number
}

/// Where the device is. Lengths are in meters.
struct Location {
    /// Degrees north of the equator (south is negative).
    latitude: Float
    /// Degrees east of Greenwich (west is negative).
    longitude: Float
    /// Above the WGS 84 ellipsoid, which isn't quite sea level.
    altitude: Float?
    /// How far off `latitude` and `longitude` may be.
    accuracy: Float?
    /// How far off `altitude` may be.
    altitudeAccuracy: Float?
    /// In meters a second.
    speed: Float?
    /// The direction it's moving in: degrees clockwise from north.
    course: Float?
    /// When it was there (see `now`).
    time: Float
    /// What told: "satellites", "network" or "other".
    source: String
}

/// Where the device is, as last heard after `startLocation`; nil until
/// then, and where that can't be known.
fn location() -> Location? {
    let l = __location()
    if l.count < 9 {
        return nil
    }
    let sources = ["satellites", "network", "other"]
    Location(latitude: l[0], longitude: l[1], altitude: __known(l[2]), accuracy: __known(l[3]),
             altitudeAccuracy: __known(l[7]), speed: __known(l[4]), course: __known(l[5]), time: l[6],
             source: sources[Int(l[8]).clamped(min: 0, max: 2)])
}

/// A navigation satellite the device hears.
struct Satellite {
    /// Whose it is: "GPS", "GLONASS", "Galileo", "BeiDou", "QZSS", "SBAS",
    /// "NavIC" or "unknown".
    system: String
    /// Its number in its system.
    number: Int
    /// Where it is in the sky: degrees clockwise from north…
    azimuth: Float
    /// …and degrees above the horizon.
    elevation: Float
    /// How strongly it's heard (C/N0, in dB-Hz); 0 when it isn't.
    signal: Float
    /// Whether it's one of those the device's place is worked out from.
    used: Bool
    /// Whether the device knows its exact orbit, and its rough one.
    hasEphemeris: Bool
    hasAlmanac: Bool
    /// Of its signal, in MHz.
    frequency: Float?
}

/// The satellites the device hears, after `startLocation` (which needs
/// the `.location` permission for them).
fn satellites() -> [Satellite] {
    let s = __satellites()
    let systems = ["unknown", "GPS", "SBAS", "GLONASS", "QZSS", "BeiDou", "Galileo", "NavIC"]
    var all: [Satellite] = []
    var at = 0
    while at + 9 <= s.count {
        let system = Int(s[at])
        all.append(Satellite(system: if system >= 0 && system < systems.count { systems[system] } else { "unknown" },
                             number: Int(s[at + 1]), azimuth: s[at + 2], elevation: s[at + 3], signal: s[at + 4],
                             used: s[at + 5] != 0, hasEphemeris: s[at + 6] != 0, hasAlmanac: s[at + 7] != 0,
                             frequency: __known(s[at + 8])))
        at += 9
    }
    all
}

/// Which way the top of the device points, in degrees clockwise from north.
struct Heading {
    /// From where a compass needle points.
    magnetic: Float
    /// From the north of maps. Known only where the device is: nil until
    /// `location()` has an answer.
    geographic: Float?
    /// How sure the compass is: 0 (not at all, wave the device in an 8) to 3.
    accuracy: Int
}

/// Which way the device points, after `startCompass`; nil until it knows,
/// and on a device without a compass.
fn heading() -> Heading? {
    let h = __heading()
    if h.count < 3 {
        return nil
    }
    var geographic: Float? = nil
    if !h[1].isNaN {
        var turned = h[0] + h[1]
        if turned < 0 { turned += 360 }
        if turned >= 360 { turned -= 360 }
        geographic = turned
    }
    Heading(magnetic: h[0], geographic: geographic, accuracy: Int(h[2]))
}

// ===== databases =====

/// A value in a database: what a column of a row holds, or a value given
/// for a `?` in SQL. Where one is wanted, an `Int`, `Float`, `String`,
/// `Bool` (stored as 1 or 0) or `Data` can be given as it is, and an
/// optional one too (`nil` is `.null`).
enum SqlValue {
    null
    int(value: Int)
    float(value: Float)
    text(value: String)
    data(value: Data)
}

/// A SQLite database file, opened with `openDatabase`.
struct Database {
    id: Int

    /// Runs SQL that changes the database (`CREATE TABLE`, `INSERT`,
    /// `UPDATE`, `DELETE`, …), with `values` for its `?`s. SQL without
    /// values can be several statements, separated by `;`. Returns how many
    /// rows the last statement changed.
    fn execute(_ sql: String, _ values: [SqlValue] = []) -> Result<Int> {
        __clearError()
        let changed = __dbExecute(id, sql, toJson(values))
        if changed < 0 {
            return Result.failure(error: Error(message: __lastError()))
        }
        Result.ok(value: changed)
    }

    /// Runs a `SELECT`, with `values` for its `?`s: its rows.
    fn query(_ sql: String, _ values: [SqlValue] = []) -> Result<[DatabaseRow]> {
        __clearError()
        if let json = __dbQuery(id, sql, toJson(values)) {
            if let table: __DatabaseTable = fromJson(json) {
                var rows: [DatabaseRow] = []
                for cells in table.rows {
                    rows.append(DatabaseRow(columns: table.columns, values: cells))
                }
                return Result.ok(value: rows)
            }
        }
        Result.failure(error: Error(message: __lastError()))
    }

    /// The row number (`rowid`) of the row the last `INSERT` added.
    fn lastInsertId() -> Int {
        __dbLastInsertId(id)
    }

    /// Closes the database. (It's closed when the program ends, too.)
    fn close() {
        __dbClose(id)
    }
}

/// A row a query found: its columns' names, and their values.
struct DatabaseRow {
    columns: [String]
    values: [SqlValue]

    /// The value of a column (by its name in the query). A name the row
    /// doesn't have stops the program.
    fn value(_ column: String) -> SqlValue {
        for (i, name) in columns.enumerated() {
            if name == column {
                return values[i]
            }
        }
        __dbNoColumn(column, columns)
        SqlValue.null
    }

    /// A column as an `Int`: a number, text of one, or 0.
    fn int(_ column: String) -> Int {
        match value(column) {
            .int(v) -> v
            .float(v) -> Int(v)
            .text(t) -> parseInt(t).valueOr(0)
            _ -> 0
        }
    }

    /// A column as a `Float`: a number, text of one, or 0.
    fn float(_ column: String) -> Float {
        match value(column) {
            .int(v) -> Float(v)
            .float(v) -> v
            .text(t) -> parseFloat(t).valueOr(0.0)
            _ -> 0.0
        }
    }

    /// A column as text (empty for null).
    fn text(_ column: String) -> String {
        match value(column) {
            .text(t) -> t
            .int(v) -> "{v}"
            .float(v) -> "{v}"
            .data(d) -> d.text ?? ""
            .null -> ""
        }
    }

    /// A column as a `Bool`: true when it's a number that isn't 0.
    fn bool(_ column: String) -> Bool {
        int(column) != 0
    }

    /// A column as bytes (a blob, or text's bytes).
    fn data(_ column: String) -> Data {
        match value(column) {
            .data(d) -> d
            .text(t) -> Data(text: t)
            _ -> Data()
        }
    }

    /// Whether a column is null.
    fn isNull(_ column: String) -> Bool {
        match value(column) {
            .null -> true
            _ -> false
        }
    }
}

/// A query's result, as the runtime gives it.
struct __DatabaseTable {
    columns: [String]
    rows: [[SqlValue]]
}

/// Opens (or creates) a SQLite database file. `":memory:"` is a database
/// that lives only while the program runs.
fn openDatabase(_ path: String) -> Result<Database> {
    __clearError()
    let id = __dbOpen(path)
    if id < 0 {
        return Result.failure(error: Error(message: __lastError()))
    }
    Result.ok(value: Database(id: id))
}

// What a value given where a `SqlValue` is wanted becomes (see the checker).
fn __sqlInt(_ v: Int) -> SqlValue { SqlValue.int(value: v) }
fn __sqlFloat(_ v: Float) -> SqlValue { SqlValue.float(value: v) }
fn __sqlText(_ v: String) -> SqlValue { SqlValue.text(value: v) }
fn __sqlBool(_ v: Bool) -> SqlValue { SqlValue.int(value: if v { 1 } else { 0 }) }
fn __sqlData(_ v: Data) -> SqlValue { SqlValue.data(value: v) }
fn __sqlOptInt(_ v: Int?) -> SqlValue {
    if let x = v {
        return __sqlInt(x)
    }
    SqlValue.null
}
fn __sqlOptFloat(_ v: Float?) -> SqlValue {
    if let x = v {
        return __sqlFloat(x)
    }
    SqlValue.null
}
fn __sqlOptText(_ v: String?) -> SqlValue {
    if let x = v {
        return __sqlText(x)
    }
    SqlValue.null
}
fn __sqlOptBool(_ v: Bool?) -> SqlValue {
    if let x = v {
        return __sqlBool(x)
    }
    SqlValue.null
}
fn __sqlOptData(_ v: Data?) -> SqlValue {
    if let x = v {
        return __sqlData(x)
    }
    SqlValue.null
}

// ---- Dialogs ----

// What a message is about: its icon.
enum AlertKind { info, warning, error }

fn __alertLevel(_ kind: AlertKind) -> Int {
    match kind {
        .info -> 0
        .warning -> 1
        .error -> 2
    }
}

// `alert("Saved")`: a message in a dialog of the system's, which the program
// waits for.
fn alert(_ title: String, message: String = "", kind: AlertKind = AlertKind.info, buttonLabel: String = "OK") {
    __messageDialog(false, title, message, buttonLabel, "", __alertLevel(kind))
}

// `confirm("Delete 3 items?")`: a question in a dialog of the system's;
// whether it was confirmed.
fn confirm(_ title: String, message: String = "", confirmLabel: String = "OK", cancelLabel: String = "Cancel",
           kind: AlertKind = AlertKind.info) -> Bool {
    __messageDialog(true, title, message, confirmLabel, cancelLabel, __alertLevel(kind))
}

// `openFiles(types: ["png"])`: like `openFile`, for several files at once.
fn openFiles(title: String = "", types: [String] = []) -> [String] {
    __openFiles(title, types)
}

// `printDocument(title: "Invoice") { g in … }`: draws pages as `writePDF`
// does, and prints them through the system's print dialog. Whether it was
// printed (not, when the dialog is cancelled).
fn printDocument(title: String = "", width: Float = 595.28, height: Float = 841.89, draw: fn(Graphics)) -> Bool {
    let path = joinPath(tempFolder(), "tessel-print-{Int(now() * 1000.0)}.pdf")
    if !writePDF(path: path, title: title, width: width, height: height, draw: draw) {
        return false
    }
    __printFile(path, title)
}

// ---- Dates in views ----

// `Calendar(date:)`: a month of days to pick one from. The time of day of
// `date` stays as it is. `firstWeekday` is 1 for Monday to 7 for Sunday.
view Calendar(date: bind Float, firstWeekday: Int = 1, onChange: fn() = {}) {
    __MonthGrid(date: date, firstWeekday: firstWeekday, onChange: onChange)
}

view __MonthGrid(date: bind Float, firstWeekday: Int = 1, onChange: fn() = {}) {
    // The first day of the month that's shown: the date's, until the arrows move it.
    state shown = 0.0

    let first = if shown == 0.0 { __dateMonthStart(date) } else { shown }
    let month = dateParts(first)
    let picked = dateParts(date)
    let today = dateParts(now())
    let blanks = (month.weekday - firstWeekday + 7) % 7
    let days = dateParts(addToDate(first, months: 1, days: -1)).day

    VStack(spacing: 6) {
        HStack(spacing: 4) {
            Icon(.chevronLeft).padding(6).hoverBackground(.separator, radius: 6)
                .onTap { shown = addToDate(first, months: -1) }
            Spacer()
            Text(formatDate(first, format: "MMMM yyyy")).font(weight: .semibold)
            Spacer()
            Icon(.chevronRight).padding(6).hoverBackground(.separator, radius: 6)
                .onTap { shown = addToDate(first, months: 1) }
        }
        HStack(spacing: 2) {
            for i in 0..7 {
                // (5 January 2026 was a Monday.)
                Text(formatDate(__dateAt(2026, 1, 4 + firstWeekday + i, 12, 0, 0), format: "EEE").characters.prefix(2).joined())
                    .font(size: 11).color(.secondary)
                    .frame(width: 30)
            }
        }
        VStack(spacing: 2) {
            for week in 0..6 {
                HStack(spacing: 2) {
                    for column in 0..7 {
                        let day = week * 7 + column - blanks + 1
                        if day >= 1 && day <= days {
                            let isPicked = day == picked.day && month.month == picked.month && month.year == picked.year
                            let isToday = day == today.day && month.month == today.month && month.year == today.year
                            Text("{day}")
                                .font(weight: if isToday { .bold } else { .regular })
                                .color(if isPicked { .white } else if isToday { .blue } else { .primary })
                                .frame(width: 30, height: 26)
                                .background(if isPicked { .blue } else { .clear }, radius: 6)
                                .hoverBackground(if isPicked { .blue } else { .separator }, radius: 6)
                                .onTap {
                                    date = __dateAt(month.year, month.month, day, picked.hour, picked.minute, picked.second)
                                    shown = 0.0
                                    onChange()
                                }
                        } else {
                            Spacer().frame(width: 30, height: 26)
                        }
                    }
                }
            }
        }
    }
    .frame(width: 222)
}

fn __dateMonthStart(_ time: Float) -> Float {
    let p = dateParts(time)
    date(year: p.year, month: p.month, day: 1, hour: 12)
}

// (`date`, for views whose own `date` hides it.)
fn __dateAt(_ year: Int, _ month: Int, _ day: Int, _ hour: Int, _ minute: Int, _ second: Int) -> Float {
    date(year: year, month: month, day: day, hour: hour, minute: minute, second: second)
}

view DatePicker(date: bind Float, format: String = "d MMM yyyy", firstWeekday: Int = 1, onChange: fn() = {}) {
    state open = false

    HStack(spacing: 6) {
        Text(formatDate(date, format: format))
        Icon(.calendar).color(.secondary)
    }
    .padding(horizontal: 8, vertical: 6)
    .background(.background, radius: 6)
    .border(.separator, radius: 6)
    .onTap { open = !open }
    .popover(isPresented: open) {
        VStack(spacing: 8) {
            __MonthGrid(date: date, firstWeekday: firstWeekday, onChange: {
                open = false
                onChange()
            })
            Divider()
            HStack {
                Button("Today") {
                    let t = dateParts(now())
                    let p = dateParts(date)
                    date = __dateAt(t.year, t.month, t.day, p.hour, p.minute, p.second)
                    open = false
                    onChange()
                }
                Spacer()
            }
        }
        .frame(width: 222)
    }
}

// ---- Views for sheets and forms ----

// `TextPrompt("Rename", text: name)`: a question with a text field, for a
// sheet. OK (or Enter) puts what was typed in `text`, closes the sheet and
// runs `onConfirm`; Cancel (or Escape) leaves `text` as it was.
view TextPrompt(_ title: String, text: bind String, message: String = "", placeholder: String = "",
                confirmLabel: String = "OK", cancelLabel: String = "Cancel", onConfirm: fn() = {}) {
    state draft = text

    VStack(spacing: 12, alignment: .leading) {
        Text(title).font(size: 15, weight: .semibold)
        if message != "" {
            Text(message).color(.secondary)
        }
        TextField(placeholder, text: draft)
            .autofocus()
            .onSubmit {
                text = draft
                dismiss()
                onConfirm()
            }
        HStack(spacing: 8) {
            Spacer()
            Button(cancelLabel) { dismiss() }
            Button(confirmLabel) {
                text = draft
                dismiss()
                onConfirm()
            }
        }
    }
    .frame(width: 300)
}

// `ProgressBar(value: 0.4)`: how far something is, from 0 to `total`.
view ProgressBar(value: Float, total: Float = 1.0) {
    Canvas { g in
        let part = if total > 0.0 { (value / total).clamped(min: 0.0, max: 1.0) } else { 0.0 }
        g.fillRect(x: 0, y: 0, width: g.width, height: g.height, color: .separator, radius: g.height / 2)
        if part > 0.0 {
            g.fillRect(x: 0, y: 0, width: max(g.height, g.width * part), height: g.height, color: .blue, radius: g.height / 2)
        }
    }
    .frame(height: 6)
}

// `ProgressPanel("Exporting…", value: done)`: a title, a progress bar, a
// note and a Cancel button, for a sheet that shows while work goes on.
view ProgressPanel(_ title: String, value: Float, total: Float = 1.0, note: String = "",
                   cancelLabel: String = "Cancel", onCancel: fn() = {}) {
    VStack(spacing: 10, alignment: .leading) {
        Text(title).font(size: 15, weight: .semibold)
        ProgressBar(value: value, total: total)
        HStack(spacing: 8) {
            Text(note).font(size: 12).color(.secondary)
            Spacer()
            if cancelLabel != "" {
                Button(cancelLabel) { onCancel() }
            }
        }
    }
    .frame(width: 300)
}

// `TimePicker(date: due)`: the hour and minute of a time, with arrows to
// change each. The day stays as it is.
view TimePicker(date: bind Float, minuteStep: Int = 5, use24Hour: Bool = true, onChange: fn() = {}) {
    let p = dateParts(date)
    let hour = if use24Hour { p.hour } else if p.hour % 12 == 0 { 12 } else { p.hour % 12 }

    HStack(spacing: 4) {
        __TimePart(text: __twoDigits(hour), onUp: {
            date = date + 3600.0
            onChange()
        }, onDown: {
            date = date - 3600.0
            onChange()
        })
        Text(":").font(weight: .semibold)
        __TimePart(text: __twoDigits(p.minute), onUp: {
            // To the next step: 9:58 goes to 10:00.
            date = __timeMinute(date, p.minute - p.minute % minuteStep + minuteStep)
            onChange()
        }, onDown: {
            let part = p.minute % minuteStep
            date = __timeMinute(date, if part == 0 { p.minute - minuteStep } else { p.minute - part })
            onChange()
        })
        if !use24Hour {
            Text(if p.hour < 12 { "AM" } else { "PM" })
                .padding(horizontal: 6, vertical: 4)
                .hoverBackground(.separator, radius: 6)
                .onTap {
                    date = date + (if p.hour < 12 { 43200.0 } else { -43200.0 })
                    onChange()
                }
        }
    }
    .padding(horizontal: 6, vertical: 2)
    .background(.background, radius: 6)
    .border(.separator, radius: 6)
}

view __TimePart(text: String, onUp: fn(), onDown: fn()) {
    HStack(spacing: 2) {
        Text(text).font(family: "monospaced")
        VStack(spacing: 0) {
            Icon(.chevronUp).font(size: 9).padding(horizontal: 2, vertical: 1).hoverBackground(.separator, radius: 3).onTap { onUp() }
            Icon(.chevronDown).font(size: 9).padding(horizontal: 2, vertical: 1).hoverBackground(.separator, radius: 3).onTap { onDown() }
        }
    }
}

fn __twoDigits(_ n: Int) -> String {
    if n < 10 { "0{n}" } else { "{n}" }
}

// `time` with its minute set (the seconds dropped); a minute past the hour's
// end or before its start moves the hour.
fn __timeMinute(_ time: Float, _ minute: Int) -> Float {
    let p = dateParts(time)
    let start = date(year: p.year, month: p.month, day: p.day, hour: p.hour)
    start + Float(minute) * 60.0
}

// `FontPicker(family: font)`: a field that shows a font family in itself,
// and opens the list of the families installed, with a field to search it.
view FontPicker(family: bind String, onChange: fn() = {}) {
    state open = false
    state search = ""

    HStack(spacing: 6) {
        Text(if family == "" { "System" } else { family }).font(family: family)
        Spacer()
        Icon(.chevronDown).font(size: 11).color(.secondary)
    }
    .padding(horizontal: 8, vertical: 6)
    .frame(width: 180)
    .background(.background, radius: 6)
    .border(.separator, radius: 6)
    .onTap {
        search = ""
        open = !open
    }
    .popover(isPresented: open) {
        let all = ["System", "Monospaced"] + fontFamilies()
        let found = if search.trim() == "" { all } else { all.filter { f in f.lowercase().contains(search.trim().lowercase()) } }
        VStack(spacing: 6, alignment: .leading) {
            TextField("Search", text: search).autofocus()
            Scroll {
                LazyVStack(count: found.count, rowHeight: 26) { i in
                    HStack {
                        Text(found[i]).font(family: __fontFamilyOf(found[i]))
                        Spacer()
                        if __fontFamilyOf(found[i]) == family {
                            Icon(.check).font(size: 11).color(.blue)
                        }
                    }
                    .padding(horizontal: 6)
                    .frame(height: 26)
                    .hoverBackground(.separator, radius: 4)
                    .onTap {
                        family = __fontFamilyOf(found[i])
                        open = false
                        onChange()
                    }
                }
            }
            .frame(height: 220)
        }
        .frame(width: 220)
    }
}

// (The first two of a font picker's list are the system's own.)
fn __fontFamilyOf(_ name: String) -> String {
    if name == "System" { "" } else if name == "Monospaced" { "monospaced" } else { name }
}
