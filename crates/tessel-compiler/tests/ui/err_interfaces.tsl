interface Shape {
    fn area() -> Float
    fn scaled(by: Float) -> Float
}

interface Named {
    name: String
}

interface Bad {
    fn f(x: Int = 1) // error: can't have default values
}

struct Circle: Shape { // error: has no method `scaled`
    radius: Float
    fn area() -> Float { radius }
}

struct Square: Shape {
    side: Float
    fn area() -> Int { 1 } // error: doesn't match what `Shape` requires
    fn scaled(by: Float) -> Float { side * by }
}

struct Anon: Named { // error: has no field `name`
    x: Int
}

struct Numbered: Named {
    name: Int // error: doesn't match what `Named` requires
}

enum Kind: Named { // error: is an enum, so it can't have the property
    a
}

struct Plain: Circle { // error: isn't an interface
    x: Int
}

struct Other: Missing { // error: unknown interface
    x: Int
}

fn main() {
    let a: Shape = Square(side: 1.0)
    let b: Shape = Plain(x: 1) // error: expected `Shape`
    let s = Shape() // error: can't be created directly
    print(a.perimeter()) // error: has no method `perimeter`
    print(a is Plain) // error: is never a `Plain`
    let n = 3
    print(n is Square) // error: works on interface values
    let c = a as Square // error: write `as?`
}
