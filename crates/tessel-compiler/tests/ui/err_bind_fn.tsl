// `bind` parameters on functions and methods.

struct Counter {
    count: Int = 0

    fn add(n: bind Int) {
        n += count
    }
}

fn bump(_ n: bind Int) {
    n += 1
}

fn read(n: Int) {
    n += 1 // error: declare the parameter `bind` to change the caller's value
}

fn withDefault(n: bind Int = 0) {} // error: a `bind` parameter can't have a default value

interface Adder {
    fn add(n: Int)
}

struct Doubler: Adder {
    fn add(n: bind Int) { // error: doesn't match what `Adder` requires
        n *= 2
    }
}

fn calls() {
    var total = 0
    bump(total)
    let k = 1
    bump(k) // error: can't be given `k`, which is a constant
    bump(3) // error: needs something it can change
    bump(total + 1) // error: needs something it can change
    let f = bump // error: so it can't be used as a value
    fn inner(x: bind Int) {} // error: only allowed on views, top-level functions and methods
    var c = Counter()
    c.add(n: total)
}
