fn types() {
    let a: Int = "hi" // error: expected `Int`, found `String`
    let one = 1
    let b = one + 2.5 // error: can't use `+` on `Int` and `Float`
    let lit = 1 + 2.5
    let c = nil // error: can't tell what type `nil` is
    let d = [] // error: can't tell what type this empty list is
    let e: Int = nil // error: `nil` can't be used as `Int`
    let name: String? = nil
    let f: String = name // error: expected `String`, found `String?`
    let g = 5 ?? 3 // error: never `nil`
    let h = "total: " + 5 // error: can't use `+` on `String` and `Int`
    let i = if a > 1 { 1 } // error: has no `else`
    print(name) // error: might be `nil`
    print(name.count) // error: might be `nil`
    let j = name?.count ?? 0
    if 1 { } // error: expected `Bool`, found `Int`
    print("{[1]}") // error: a list can't be shown as text
}

fn needsValue() -> Int {
    let x = 1
} // error: this block must end with `Int`

fn noValue() {
    return 5 // error: doesn't return a value
}

fn wrongReturn() -> String {
    return 5 // error: expected `String`, found `Int`
}

struct Loop { // error: contains itself
    next: Loop?
}

struct Tree {
    children: [Tree]
}

fn keys() {
    let d: [[Int]: String] = [:] // error: can't be used as a dictionary key
}

fn optionalArithmetic() {
    let a: Int? = 3
    print(a + 1) // error: can't use `+` on `Int?` and `Int`
    var f: fn()? = nil
    print(f == nil)
    for _ in 0..2 {
        print("unused loop variable")
    }
}

app Shortcuts {
    VStack {
        Button("A") {}.shortcut("s") {}
        Button("B") {}.shortcut("enter") {}
        Button("C") {}.shortcut("F5") {} // error: `F5` isn't a key a shortcut can use
        Button("D") {}.shortcut("cmd+k") {} // error: `cmd+k` isn't a key a shortcut can use
        Button("E") {}.shortcut("S") {} // error: `S` isn't a key a shortcut can use
    }
}
