// scrollTo takes the `.id` of a view: an Int or a String.

app Jump {
    state size = 100.0

    VStack {
        Button("Go") {
            scrollTo(1.5) // error: `scrollTo` needs an `Int` or `String`, found `Float`
            scrollTo("top", align: .left) // error: `ScrollAlign` has no case `.left`
        }
        HSplit(size: 3) { // error: needs something it can change
            Text("a")
            Text("b")
        }
    }
}
